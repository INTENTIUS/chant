# Each variable below is the declared `env` mapping of a build parameter in
# chant.config.ts. Source this file and `chant build` picks them up:
#
#   set -a && source .env && set +a
#
# Or pass them per invocation instead, which is what CI should do:
#
#   chant build src/shared --lexicon gcp --param projectId=my-project
#
# Nothing in src/ reads process.env. Every parameter has a placeholder default,
# so the example builds with none of these set — it just does not deploy.

# === GCP ===
GCP_PROJECT_ID=                            # REQUIRED — GCP project ID                    (param: projectId)
GCP_PROJECT_NUMBER=                        # REQUIRED — gcloud projects describe $GCP_PROJECT_ID --format='value(projectNumber)'   (param: projectNumber)
CRDB_DOMAIN=crdb.example.com               # REQUIRED — base domain for UI ingress; subdomains east.*, central.*, west.*           (param: domain)
