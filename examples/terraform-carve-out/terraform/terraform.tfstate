{
  "version": 4,
  "terraform_version": "1.7.0",
  "serial": 1,
  "lineage": "00000000-0000-0000-0000-000000000000",
  "resources": [
    {
      "mode": "managed",
      "type": "aws_s3_bucket",
      "name": "assets",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "myapp-assets-prod",
            "bucket": "myapp-assets-prod",
            "arn": "arn:aws:s3:::myapp-assets-prod",
            "region": "us-east-1",
            "tags": { "Team": "web", "Env": "prod" },
            "force_destroy": false
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_cloudwatch_log_group",
      "name": "api",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "/myapp/api",
            "name": "/myapp/api",
            "arn": "arn:aws:logs:us-east-1:123456789012:log-group:/myapp/api",
            "retention_in_days": 30,
            "tags": {}
          }
        }
      ]
    }
  ]
}
