{
  "version": 4,
  "terraform_version": "1.7.0",
  "serial": 1,
  "lineage": "00000000-0000-0000-0000-000000000000",
  "resources": [
    {
      "mode": "managed",
      "type": "kubernetes_namespace",
      "name": "web",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "web",
            "metadata": [ { "name": "web", "labels": {}, "annotations": {} } ]
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "kubernetes_manifest",
      "name": "app_config",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "manifest": {
              "apiVersion": "v1",
              "kind": "ConfigMap",
              "metadata": {
                "name": "app-config",
                "namespace": "web",
                "labels": { "app.kubernetes.io/name": "web" }
              },
              "data": { "LOG_LEVEL": "info" }
            },
            "computed_fields": ["metadata.labels", "metadata.annotations"],
            "field_manager": null,
            "wait": null
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "kubernetes_manifest",
      "name": "web_cert",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "manifest": {
              "apiVersion": "cert-manager.io/v1",
              "kind": "Certificate",
              "metadata": { "name": "web-tls", "namespace": "web" },
              "spec": {
                "secretName": "web-tls",
                "dnsNames": ["web.example.com"],
                "issuerRef": { "name": "letsencrypt", "kind": "ClusterIssuer" }
              }
            },
            "computed_fields": ["metadata.labels", "metadata.annotations"]
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "kubernetes_config_map",
      "name": "legacy",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "web/legacy",
            "metadata": [ { "name": "legacy", "namespace": "web" } ],
            "data": { "OLD": "true" }
          }
        }
      ]
    }
  ]
}
