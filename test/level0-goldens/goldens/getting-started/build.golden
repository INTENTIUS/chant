# chant build
# on a copy of examples/getting-started; see test/level0-goldens/harness.ts for what is normalised
exit: 0

--- wrote
!! dist/ops/apply/op.json
!! dist/ops/deploy-gated/op.json
!! dist/ops/deploy/op.json
!! dist/ops/observe/op.json
!! dist/ops/reconcile/op.json

--- stdout
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  labels:
    app.kubernetes.io/managed-by: chant
    chant.intentius.io/stack: getting-started
    chant.intentius.io/env: local
    app.kubernetes.io/name: web
    app.kubernetes.io/component: server
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: web
  template:
    metadata:
      labels:
        app.kubernetes.io/name: web
    spec:
      containers:
        - name: web
          image: nginxinc/nginx-unprivileged:1.27-alpine
          ports:
            - containerPort: 8080
              name: http
          resources:
            limits:
              cpu: '200m'
              memory: '128Mi'
            requests:
              cpu: '50m'
              memory: '64Mi'
          livenessProbe:
            httpGet:
              path: /
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 5
          securityContext:
            runAsNonRoot: true
            runAsUser: 101
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL

---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: web
  labels:
    app.kubernetes.io/managed-by: chant
    chant.intentius.io/stack: getting-started
    chant.intentius.io/env: local
    app.kubernetes.io/name: web
    app.kubernetes.io/component: disruption-budget
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: web

---
apiVersion: v1
kind: Service
metadata:
  name: web
  labels:
    app.kubernetes.io/managed-by: chant
    chant.intentius.io/stack: getting-started
    chant.intentius.io/env: local
    app.kubernetes.io/name: web
    app.kubernetes.io/component: server
spec:
  selector:
    app.kubernetes.io/name: web
  ports:
    - port: 80
      targetPort: 8080
      protocol: TCP
      name: http
  type: ClusterIP


--- stderr
fold: <n> files folded, <n> ran (--verbose for reasons)
Wrote 6 op.json file(s) under dist/ops/
warning: [web] Container "web" in Deployment "web" has no explicit imagePullPolicy — set it to "Always", "IfNotPresent", or "Never" (k8s)
warning: [web] Container "web" in Deployment "web" does not set readOnlyRootFilesystem: true — set it to reduce the attack surface (k8s)
