# Persona: Release validation (actual cloud deploys)
# Questions answered:
#   - Do examples deploy end-to-end to real cloud providers?
#   - Does the full lifecycle (build → deploy → verify → teardown) work?
# Flow: Stage 1 (node) packs tarballs → Stage 2 (node + deploy tools) runs e2e-smoke.sh at container start
# Requires: cloud credentials mounted via Docker -v / -e flags
#
# NOTE: This image is always built as linux/amd64 because it installs x86_64-only
# CLI binaries (AWS CLI and gcloud are downloaded via hardcoded x86_64 URLs below).
# On Apple Silicon the runner stage uses Rosetta emulation transparently.

# ── Stage 1: builder ─────────────────────────────────────────────────────────
FROM --platform=linux/amd64 node:24-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y jq && rm -rf /var/lib/apt/lists/*
RUN npm install -g tsx

COPY . .

RUN npm install

# The lexicons this image packs are listed once, in test/smoke-e2e-lexicons.txt:
# each lexicon an example uses, and the lexicons they depend on (k8s needs
# prometheus and otel, gitlab needs github) so the image tests this commit's
# copy of those rather than the registry's. smoke.sh's build_e2e_image reads
# the same list, and test/smoke-tarball-deps.test.ts checks that every loop
# here reads it.

# Generate dist/ artifacts for each lexicon
RUN LEXICONS=$(cat /app/test/smoke-e2e-lexicons.txt) && \
    for lex in $LEXICONS; do \
      echo "=== prepack lexicons/$lex ===" && \
      npm run --prefix "lexicons/$lex" prepack; \
    done

# Fix workspace:* deps → real version, strip scripts
RUN CORE_VERSION=$(jq -r '.version' packages/core/package.json) && \
    LEXICONS=$(cat /app/test/smoke-e2e-lexicons.txt) && \
    cd /app/packages/core && \
    jq 'del(.scripts)' package.json > tmp.json && mv tmp.json package.json && \
    for lex in $LEXICONS; do \
      cd /app/lexicons/$lex && \
      jq --arg v "$CORE_VERSION" \
        '(if .dependencies then .dependencies |= with_entries(if .value == "workspace:*" then .value = $v else . end) else . end) | del(.scripts)' \
        package.json > tmp.json && mv tmp.json package.json || exit 1; \
    done

# Pack tarballs (rm stale .tgz first — glob with multiple matches breaks mv)
RUN LEXICONS=$(cat /app/test/smoke-e2e-lexicons.txt) && \
    mkdir -p /tarballs && \
    cd /app/packages/core && rm -f *.tgz && npm pack && mv *.tgz /tarballs/core.tgz && \
    for lex in $LEXICONS; do \
      cd /app/lexicons/$lex && rm -f *.tgz && npm pack && mv *.tgz /tarballs/lexicon-${lex}.tgz || exit 1; \
    done

# ── Stage 2: E2E runner ──────────────────────────────────────────────────────
FROM --platform=linux/amd64 node:24-slim

# Install base tools
RUN apt-get update && apt-get install -y \
      curl unzip jq git ca-certificates gnupg \
    && rm -rf /var/lib/apt/lists/*

# tsx — the chant bin wrapper uses it as fallback runtime
RUN npm install -g tsx

# Git identity for E2E commits (push_to_gitlab needs this)
RUN git config --global user.email "e2e@chant.dev" && \
    git config --global user.name "Chant E2E"

# kubectl
RUN curl -fsSL "https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" \
      -o /usr/local/bin/kubectl && chmod +x /usr/local/bin/kubectl

# AWS CLI v2
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip && \
    unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/aws /tmp/awscliv2.zip

# gcloud CLI + GKE auth plugin
RUN curl -fsSL https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-x86_64.tar.gz \
      -o /tmp/gcloud.tar.gz && \
    tar xzf /tmp/gcloud.tar.gz -C /opt && \
    /opt/google-cloud-sdk/install.sh --quiet --path-update=true && \
    /opt/google-cloud-sdk/bin/gcloud components install gke-gcloud-auth-plugin --quiet && \
    rm /tmp/gcloud.tar.gz
ENV PATH="/opt/google-cloud-sdk/bin:$PATH"
ENV USE_GKE_GCLOUD_AUTH_PLUGIN=True

# Azure CLI
RUN curl -fsSL https://aka.ms/InstallAzureCLIDeb | bash

# Copy tarballs from builder
COPY --from=builder /tarballs /tarballs

# Copy example source directories
COPY --from=builder /app/examples /examples

# Copy E2E test script
COPY test/e2e-smoke.sh /e2e-smoke.sh
RUN chmod +x /e2e-smoke.sh

ENTRYPOINT ["/e2e-smoke.sh"]
CMD ["all"]
