# Persona: New User of the sql lexicon (registry install path, #3641)
#
# Installs @intentius/chant and @intentius/chant-lexicon-sql from the registry
# at one version, nothing from the workspace, then runs sql-registry-smoke.sh at
# container start against the servers `chant emulator up --lexicon sql` starts.
# The run needs the Docker socket mounted; `./test/smoke.sh sql-registry`
# builds and runs it.
#
# CHANT_VERSION is a version or dist-tag. smoke.sh resolves `latest` to the
# version it names before building, so a new release is a new layer rather
# than a cached install of the old one.
FROM docker:28.5.1-cli AS docker-cli

FROM node:24-slim
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
# `chant run` reads the project's git state.
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
ARG CHANT_VERSION=latest
WORKDIR /smoke
RUN echo '{ "name": "sql-registry-smoke", "version": "0.0.1", "private": true, "type": "module" }' > package.json \
 && npm install --no-audit --no-fund \
      "@intentius/chant@${CHANT_VERSION}" \
      "@intentius/chant-lexicon-sql@${CHANT_VERSION}" \
      typescript
COPY test/sql-registry-smoke.sh /sql-registry-smoke.sh
ENTRYPOINT ["bash", "/sql-registry-smoke.sh"]
