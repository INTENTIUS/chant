# Example build outputs
examples/*/k8s.yaml
examples/*/templates/*.json
examples/*/.gitlab-ci.yml
examples/*/.github/

# supply-chain example: generated SBOM/config-BOM (npm run supply-chain)
examples/supply-chain/sbom.*.json
examples/supply-chain/config-bom.*.json

# Docker smoke build artifacts
test/example-builds/

# Claude Code
.claude/
CLAUDE.md

# Scratch project the fountain init-template test materializes (cleaned up in afterAll)
lexicons/fountain/.init-template-*/

