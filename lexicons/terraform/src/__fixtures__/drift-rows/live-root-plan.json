{
  "format_version": "1.2",
  "terraform_version": "1.9.8",
  "resource_drift": [
    {
      "address": "aws_s3_bucket.ignored",
      "mode": "managed",
      "type": "aws_s3_bucket",
      "change": { "actions": ["update"], "before": { "bucket": "ignored" }, "after": { "bucket": "ignored-too" } }
    }
  ],
  "resource_changes": [
