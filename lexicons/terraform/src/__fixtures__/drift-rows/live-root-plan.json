    },
    {
      "address": "aws_s3_bucket.steady",
      "mode": "managed",
      "type": "aws_s3_bucket",
      "name": "steady",
      "change": { "actions": ["no-op"], "before": { "bucket": "acme-steady" }, "after": { "bucket": "acme-steady" } }
    },
    {
      "address": "data.aws_region.here",
      "mode": "data",
      "type": "aws_region",
      "name": "here",
