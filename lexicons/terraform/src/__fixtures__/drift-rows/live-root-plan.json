      "change": { "actions": ["create"], "before": null, "after": { "bucket": "acme-assets" }, "after_unknown": { "arn": true, "id": true } }
    },
    {
      "address": "aws_sqs_queue.stray",
      "mode": "managed",
      "type": "aws_sqs_queue",
