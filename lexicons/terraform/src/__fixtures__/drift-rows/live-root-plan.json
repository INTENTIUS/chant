    },
    {
      "address": "data.aws_caller_identity.me",
      "mode": "data",
      "type": "aws_caller_identity",
      "name": "me",
      "change": { "actions": ["update"], "before": { "account_id": "000000000000" }, "after": { "account_id": "000000000001" } }
