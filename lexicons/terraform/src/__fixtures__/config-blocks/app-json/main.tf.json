{
  "//": "The config blocks of ../app/main.tf in Terraform's JSON syntax (chant#4457, chant#4458): each becomes the entity its HCL form does.",
  "variable": {
    "region": { "type": "string" }
  },
  "resource": {
    "aws_instance": {
      "web": { "ami": "ami-123", "instance_type": "t3.micro" }
    },
    "aws_lb": {
      "front": { "name": "front" }
    }
  },
  "moved": [
    { "from": "aws_instance.old", "to": "aws_instance.web" },
    { "from": "module.legacy", "to": "module.network" }
  ],
  "import": {
    "to": "aws_lb.front",
    "id": "arn:aws:elasticloadbalancing:us-east-1:123456789012:loadbalancer/app/front/abc"
  },
  "removed": {
    "from": "aws_instance.gone",
    "lifecycle": { "destroy": false }
  },
  "check": {
    "health": {
      "data": {
        "http": {
          "site": { "url": "https://${aws_lb.front.dns_name}/healthz" }
        }
      },
      "assert": {
        "condition": "${data.http.site.status_code == 200}",
        "error_message": "front is down in ${var.region}"
      }
    }
  }
}
