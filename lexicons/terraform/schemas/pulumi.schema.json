{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pulumi.yaml",
  "type": "object",
  "required": [
    "name",
    "runtime"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
