{
  "name": "@intentius/chant-lexicon-pulumi",
  "version": "0.124.34",
  "type": "module",
  "files": [
    "src/",
    "dist/",
    "schemas/",
    "workspace-kinds.json"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workspace-kinds": "./workspace-kinds.json",
    "./lint/post-synth": {
      "development": "./src/lint/post-synth/index.ts",
      "types": "./dist/lint/post-synth/index.d.ts",
      "default": "./dist/lint/post-synth/index.js"
    },
    "./op/activities": {
      "development": "./src/op/activities/index.ts",
      "types": "./dist/op/activities/index.d.ts",
      "default": "./dist/op/activities/index.js"
    },
    "./op/activity-contracts": {
      "development": "./src/op/activity-contracts.ts",
      "types": "./dist/op/activity-contracts.d.ts",
      "default": "./dist/op/activity-contracts.js"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "generate": "node -e \"console.log('pulumi: nothing to generate, the lexicon has no declarable kinds')\"",
    "validate": "node -e \"console.log('pulumi: nothing to validate')\"",
    "bundle": "tsx src/package-cli.ts",
    "docs": "npx tsx src/codegen/docs-cli.ts",
    "build": "../../scripts/tsc7.sh -p tsconfig.build.json --sourceMap false && tsc-alias -p tsconfig.build.json",
    "prepack": "npm run generate && npm run bundle && npm run validate && npm run build"
  },
  "devDependencies": {
    "@intentius/chant": "*",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@intentius/chant": "^0.124.34",
    "zod": "^4.3.6"
  },
  "description": "pulumi lexicon for chant: a Pulumi program as a workspace member, its preview in the change set and its refresh as drift records",
  "license": "Apache-2.0",
  "homepage": "https://github.com/INTENTIUS/chant#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/INTENTIUS/chant.git",
    "directory": "lexicons/pulumi"
  },
  "bugs": {
    "url": "https://github.com/INTENTIUS/chant/issues"
  },
  "keywords": [
    "chant",
    "pulumi",
    "iac"
  ]
}
