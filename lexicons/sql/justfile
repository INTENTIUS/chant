# Default recipe - list all available commands
default:
    @just --list

# Generate the ClickHouse types from the committed catalog snapshot (a pin move reads the pinned server)
generate:
    npx tsx src/codegen/generate-cli.ts

# Re-read the pinned ClickHouse server even when the snapshot matches the pin (needs Docker)
refresh-catalog:
    npx tsx src/codegen/generate-cli.ts --force

# Validate generated artifacts
validate:
    npx tsx src/validate-cli.ts

# Generate this lexicon's docs into the main site (docs/src/content/docs/lexicons/), then start its dev server
docs:
    npx tsx src/codegen/docs-cli.ts
    npm install --prefix ../../docs
    npm run --prefix ../../docs dev

# Build the whole docs site, every lexicon's section included
docs-build:
    cd ../.. && bash scripts/build-docs.sh

# Package the lexicon (generate + validate)
package: generate validate
