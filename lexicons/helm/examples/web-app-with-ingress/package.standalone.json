{
  "name": "helm-web-app-with-ingress-example",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "npx vitest run",
    "build": "chant build src --lexicon helm -o Chart.yaml",
    "lint": "chant lint src",
    "dev": "chant build src --lexicon helm -o Chart.yaml --watch",
    "deploy": "helm install web-app-ingress .",
    "teardown": "helm uninstall web-app-ingress"
  },
  "dependencies": {
    "@intentius/chant": "^0.0.14",
    "@intentius/chant-lexicon-helm": "^0.0.14",
    "@intentius/chant-lexicon-k8s": "^0.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3 || ^7.0.0"
  }
}
