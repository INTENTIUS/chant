{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "chant-fx-tabs"
  },
  "spec": {
    "title": "Checkout (tabs)",
    "description": "A v2 dashboard with tabs, an auto grid, nested rows and conditional rendering",
    "tags": [
      "fixture",
      "v2"
    ],
    "editable": true,
    "cursorSync": "Crosshair",
    "liveNow": false,
    "preload": false,
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "links": [
      {
        "title": "Runbook",
        "type": "link",
        "icon": "doc",
        "tooltip": "",
        "url": "https://example.com/runbooks/checkout",
        "tags": [],
        "asDropdown": false,
        "targetBlank": true,
        "includeVars": false,
        "keepTime": false,
        "placement": "inControlsMenu"
      }
    ],
    "timeSettings": {
      "timezone": "utc",
      "from": "now-3h",
      "to": "now",
      "autoRefresh": "1m",
      "autoRefreshIntervals": [
        "30s",
        "1m",
        "5m"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0,
      "weekStart": "monday",
      "nowDelay": "1m",
      "quickRanges": [
        {
          "display": "Last business day",
          "from": "now-1d/d",
          "to": "now-1d/d"
        }
      ]
    },
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "prometheus",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "Prometheus",
            "value": "prom"
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": true
        }
      },
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "env",
          "query": "prod,staging",
          "current": {
            "text": "prod",
            "value": "prod"
          },
          "options": [
            {
              "selected": true,
              "text": "prod",
              "value": "prod"
            },
            {
              "selected": false,
              "text": "staging",
              "value": "staging"
            }
          ],
          "multi": false,
          "includeAll": false,
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": true
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "job",
          "current": {
            "text": "",
            "value": ""
          },
          "hide": "inControlsMenu",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${datasource}"
            },
            "spec": {
              "qryType": 1,
              "query": "label_values(up, job)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          },
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "label_values(up, job)",
          "options": [],
          "multi": false,
          "includeAll": false,
          "allowCustomValue": true
        }
      },
      {
        "kind": "SwitchVariable",
        "spec": {
          "name": "detailed",
          "current": "false",
          "enabledValue": "true",
          "disabledValue": "false",
          "label": "Detailed",
          "hide": "dontHide",
          "skipUrlSync": false
        }
      },
      {
        "kind": "GroupByVariable",
        "group": "prometheus",
        "datasource": {
          "name": "${datasource}"
        },
        "spec": {
          "name": "groupBy",
          "current": {
            "text": [
              "route"
            ],
            "value": [
              "route"
            ]
          },
          "options": [],
          "multi": true,
          "hide": "dontHide",
          "skipUrlSync": false
        }
      }
    ],
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Availability",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "avg(up{job=\"checkout\"})",
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.2",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Request rate",
          "description": "Requests per second by route",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum by (route) (rate(http_requests_total{job=\"checkout\"}[5m]))",
                        "legendFormat": "{{route}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum(rate(http_requests_total{job=\"checkout\"}[5m]))",
                        "legendFormat": "total",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": true
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "disabled": true,
                    "options": {
                      "renameByName": {
                        "total": "all"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {
                "maxDataPoints": 500,
                "interval": "30s",
                "timeFrom": "1h"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.2",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "p99 latency",
          "description": "",
          "links": [],
          "transparent": true,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"checkout\", env=\"$env\"}[5m])))",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.2",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "s"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Checkout logs",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "loki"
                      },
                      "spec": {
                        "expr": "{service=\"checkout\"}",
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "13.2.2",
            "spec": {
              "options": {
                "showTime": true,
                "wrapLogMessage": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "TabsLayout",
      "spec": {
        "tabs": [
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "title": "Overview",
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 2,
                  "columnWidthMode": "standard",
                  "rowHeightMode": "short",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-1"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-2"
                        },
                        "conditionalRendering": {
                          "kind": "ConditionalRenderingGroup",
                          "spec": {
                            "visibility": "show",
                            "condition": "and",
                            "items": [
                              {
                                "kind": "ConditionalRenderingVariable",
                                "spec": {
                                  "variable": "detailed",
                                  "operator": "equals",
                                  "value": "true"
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "title": "Details",
              "layout": {
                "kind": "RowsLayout",
                "spec": {
                  "rows": [
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "title": "Latency ($env)",
                        "collapse": false,
                        "repeat": {
                          "mode": "variable",
                          "value": "env"
                        },
                        "layout": {
                          "kind": "GridLayout",
                          "spec": {
                            "items": [
                              {
                                "kind": "GridLayoutItem",
                                "spec": {
                                  "x": 0,
                                  "y": 0,
                                  "width": 24,
                                  "height": 8,
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-3"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "title": "Logs",
                        "collapse": true,
                        "fillScreen": true,
                        "conditionalRendering": {
                          "kind": "ConditionalRenderingGroup",
                          "spec": {
                            "visibility": "show",
                            "condition": "and",
                            "items": [
                              {
                                "kind": "ConditionalRenderingData",
                                "spec": {
                                  "value": true
                                }
                              }
                            ]
                          }
                        },
                        "layout": {
                          "kind": "GridLayout",
                          "spec": {
                            "items": [
                              {
                                "kind": "GridLayoutItem",
                                "spec": {
                                  "x": 0,
                                  "y": 0,
                                  "width": 24,
                                  "height": 10,
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-4"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
