{
  "title": "Checkout SLO",
  "uid": "chant-fx-slo",
  "tags": [
    "fixture",
    "slo"
  ],
  "schemaVersion": 39,
  "refresh": "1m",
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ]
  },
  "links": [
    {
      "title": "Service dashboards",
      "type": "dashboards",
      "tags": [
        "checkout"
      ],
      "asDropdown": false,
      "icon": "external link",
      "tooltip": "",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "route",
        "datasource": {
          "type": "prometheus",
          "uid": "prom"
        },
        "definition": "label_values(http_requests_total, route)",
        "query": {
          "qryType": 1,
          "query": "label_values(http_requests_total, route)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "gauge",
      "id": 1,
      "title": "Error budget left",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "1 - (sum(rate(http_requests_total{code=~\"5..\", route=~\"$route\"}[30d])) / sum(rate(http_requests_total{route=~\"$route\"}[30d]))) / 0.001",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 25
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number",
              "scope": "series"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "type": "heatmap",
      "id": 2,
      "title": "Latency distribution",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (le) (rate(http_request_duration_seconds_bucket{route=~\"$route\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges"
        },
        "cellGap": 1
      }
    },
    {
      "type": "text",
      "id": 3,
      "title": "About",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "options": {
        "mode": "markdown",
        "content": "Objective: **99.9%** of checkout requests succeed over 30 days."
      }
    },
    {
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 6
      },
      "title": "Burn rate",
      "libraryPanel": {
        "uid": "chant-fx-burn",
        "name": "Burn rate"
      }
    }
  ]
}
