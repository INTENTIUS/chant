    {
      "type": "table",
      "id": 16,
      "title": "SQL Server: deadlocks",
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "mssql",
        "uid": "sqlserver"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "sqlserver"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
