    {
      "type": "timeseries",
      "id": 17,
      "title": "Mixed: latency with exemplars, GCM PromQL and log rate",
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"checkout\"}[$__rate_interval])))",
          "exemplar": true,
          "legendFormat": "p99"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "my-project",
            "expr": "histogram_quantile(0.99, sum by (le) (rate(loadbalancing_googleapis_com:https_total_latencies_bucket[5m])))",
            "step": "10s"
          }
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({service=\"checkout\"} |= \"error\" [$__auto]))",
          "queryType": "range"
        }
      ]
