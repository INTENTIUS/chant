    {
      "type": "timeseries",
      "id": 9,
      "title": "Cloud Monitoring: CPU",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "stackdriver",
        "uid": "gcm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "my-project",
            "filters": [
              "metric.type",
              "=",
              "compute.googleapis.com/instance/cpu/utilization"
            ],
            "crossSeriesReducer": "REDUCE_MEAN",
            "perSeriesAligner": "ALIGN_MEAN",
            "alignmentPeriod": "cloud-monitoring-auto",
            "groupBys": [
              "resource.label.zone"
            ],
            "view": "FULL"
          },
          "aliasBy": "{{resource.label.zone}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "my-project",
            "expr": "sum(rate(kubernetes_io:container_cpu_core_usage_time[5m]))",
            "step": "10s"
          }
        }
      ]
    },
