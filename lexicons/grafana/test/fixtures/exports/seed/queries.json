    {
      "type": "timeseries",
      "id": 15,
      "title": "MySQL: signups",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql"
