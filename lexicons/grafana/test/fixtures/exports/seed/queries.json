      "title": "BigQuery: orders per hour",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery"
          },
          "format": 1,
          "rawQuery": true,
          "editorMode": "code",
          "location": "US",
          "project": "my-project",
          "dataset": "shop",
          "table": "orders",
          "rawSql": "SELECT TIMESTAMP_TRUNC(created_at, HOUR) AS time, COUNT(*) AS orders FROM `my-project.shop.orders` WHERE $__timeFilter(created_at) GROUP BY time ORDER BY time"
        }
      ]
    },
    {
