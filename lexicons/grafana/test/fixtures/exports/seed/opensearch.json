{
  "dashboard": {
    "uid": "chant-fx-opensearch",
    "title": "OpenSearch queries",
    "schemaVersion": 42,
    "time": { "from": "now-6h", "to": "now" },
    "panels": [
      {
        "id": 1, "type": "timeseries", "title": "Errors over time (Lucene metrics)",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
            "queryType": "lucene",
            "luceneQueryType": "Metric",
            "query": "level:error",
            "alias": "errors",
            "timeField": "@timestamp",
            "metrics": [{ "id": "1", "type": "count" }, { "id": "2", "type": "avg", "field": "duration_ms", "settings": { "missing": "0" } }],
            "bucketAggs": [{ "id": "3", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "auto", "min_doc_count": "0", "trimEdges": "0" } }]
          }
        ]
      },
      {
        "id": 2, "type": "logs", "title": "Logs (Lucene)",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
            "queryType": "lucene",
            "luceneQueryType": "Logs",
            "query": "service:checkout AND level:error",
            "timeField": "@timestamp",
            "metrics": [{ "id": "1", "type": "logs", "settings": { "limit": "500" } }],
            "bucketAggs": []
          }
        ]
      },
      {
        "id": 3, "type": "table", "title": "Raw data (Lucene)",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
            "queryType": "lucene",
            "luceneQueryType": "RawData",
            "query": "*",
            "timeField": "@timestamp",
            "metrics": [{ "id": "1", "type": "raw_data", "settings": { "size": "100" } }],
            "bucketAggs": []
          }
        ]
      },
      {
        "id": 4, "type": "table", "title": "Top services (PPL table)",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
            "queryType": "PPL",
            "format": "table",
            "query": "source = logs-* | stats count() by service | sort - count() | head 10"
          }
        ]
      },
      {
        "id": 5, "type": "timeseries", "title": "Requests per minute (PPL time series)",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
            "queryType": "PPL",
            "format": "time_series",
            "query": "source = logs-* | stats count() by span(@timestamp, 1m)"
          }
        ]
      },
      {
        "id": 6, "type": "logs", "title": "Logs (PPL)",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
            "queryType": "PPL",
            "format": "logs",
            "query": "source = logs-* | where level = 'error' | head 50"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
