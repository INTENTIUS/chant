{
  "__inputs": [
    {
      "name": "DS_OPENSEARCH",
      "label": "OpenSearch",
      "description": "",
      "type": "datasource",
      "pluginId": "grafana-opensearch-datasource",
      "pluginName": "OpenSearch"
    }
  ],
  "__elements": {},
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "13.2.2"
    },
    {
      "type": "datasource",
      "id": "grafana-opensearch-datasource",
      "name": "OpenSearch",
      "version": "2.34.4"
    },
    {
      "type": "panel",
      "id": "logs",
      "name": "Logs",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "alias": "errors",
          "bucketAggs": [
            {
              "field": "@timestamp",
              "id": "3",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0",
                "trimEdges": "0"
              },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH}"
          },
          "luceneQueryType": "Metric",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            },
            {
              "field": "duration_ms",
              "id": "2",
              "settings": {
                "missing": "0"
              },
              "type": "avg"
            }
          ],
          "query": "level:error",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Errors over time (Lucene metrics)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "bucketAggs": [],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH}"
          },
          "luceneQueryType": "Logs",
          "metrics": [
            {
              "id": "1",
              "settings": {
                "limit": "500"
              },
              "type": "logs"
            }
          ],
          "query": "service:checkout AND level:error",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Logs (Lucene)",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "bucketAggs": [],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH}"
          },
          "luceneQueryType": "RawData",
          "metrics": [
            {
              "id": "1",
              "settings": {
                "size": "100"
              },
              "type": "raw_data"
            }
          ],
          "query": "*",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Raw data (Lucene)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH}"
          },
          "format": "table",
          "query": "source = logs-* | stats count() by service | sort - count() | head 10",
          "queryType": "PPL",
          "refId": "A"
        }
      ],
      "title": "Top services (PPL table)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "targets": [
        {
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH}"
          },
          "format": "time_series",
          "query": "source = logs-* | stats count() by span(@timestamp, 1m)",
          "queryType": "PPL",
          "refId": "A"
        }
      ],
      "title": "Requests per minute (PPL time series)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "targets": [
        {
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_OPENSEARCH}"
          },
          "format": "logs",
          "query": "source = logs-* | where level = 'error' | head 50",
          "queryType": "PPL",
          "refId": "A"
        }
      ],
      "title": "Logs (PPL)",
      "type": "logs"
    }
  ],
  "schemaVersion": 42,
  "tags": [],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "OpenSearch queries",
  "uid": "chant-fx-opensearch",
  "version": 1,
  "weekStart": ""
}
