            "columns": [
              {
                "parameters": [
                  {
                    "name": "customer_id",
                    "type": "functionParameter"
                  }
                ],
                "type": "function"
              },
              {
                "name": "SUM",
                "parameters": [
                  {
                    "name": "total",
                    "type": "functionParameter"
                  }
                ],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "name": "customer_id",
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 10,
            "orderBy": {
              "property": {
                "name": "SUM(total)",
                "type": "string"
              },
              "type": "property"
            },
            "orderByDirection": "DESC"
          },
          "table": "orders"
