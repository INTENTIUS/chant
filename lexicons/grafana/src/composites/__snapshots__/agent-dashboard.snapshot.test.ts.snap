      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(genai_tokens_input_total{gen_ai_request_model=~\\"$model\\"}[$__range]))",
          "legendFormat": "Input tokens",
          "instant": true,
          "range": false
        }
      ],
      "options": {
