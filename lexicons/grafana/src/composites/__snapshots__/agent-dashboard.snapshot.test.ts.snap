  "refresh": "1m",
  "schemaVersion": 42,
  "tags": [
    "genai",
    "agents"
  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(genai_calls_total, service_name)",
        "definition": "label_values(genai_calls_total, service_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "options": []
      },
      {
        "type": "query",
        "name": "model",
        "label": "Model",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(genai_calls_total, gen_ai_request_model)",
