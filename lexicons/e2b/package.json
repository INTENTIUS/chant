{
  "name": "@intentius/chant-lexicon-e2b",
  "version": "0.124.32",
  "type": "module",
  "description": "e2b lexicon for chant — run Ops on a steward sandbox on E2B, or any API that speaks E2B's, and declare the template it is made from",
  "license": "Apache-2.0",
  "homepage": "https://github.com/INTENTIUS/chant#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/INTENTIUS/chant.git",
    "directory": "lexicons/e2b"
  },
  "bugs": {
    "url": "https://github.com/INTENTIUS/chant/issues"
  },
  "keywords": [
    "chant",
    "e2b",
    "sandbox",
    "ops",
    "template"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "dist/"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./lint/post-synth": {
      "development": "./src/lint/post-synth/index.ts",
      "types": "./dist/lint/post-synth/index.d.ts",
      "default": "./dist/lint/post-synth/index.js"
    },
    "./manifest": "./dist/manifest.json",
    "./meta": "./dist/meta.json",
    "./types": "./dist/types/index.d.ts"
  },
  "scripts": {
    "generate": "tsx src/codegen/generate-cli.ts",
    "bundle": "tsx src/package-cli.ts",
    "docs": "tsx src/codegen/docs-cli.ts",
    "prepack": "npm run generate && npm run bundle && npm run build",
    "build": "../../scripts/tsc7.sh -p tsconfig.build.json --sourceMap false && tsc-alias -p tsconfig.build.json"
  },
  "dependencies": {
    "e2b": "^2.56.0"
  },
  "peerDependencies": {
    "@intentius/chant": "^0.124.32",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@intentius/chant": "*",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.9.3"
  }
}
