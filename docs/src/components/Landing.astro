---
// The home page's parts. `part="top"` (the default) is the pixel face, which
// opens the docs, then ProductHome (the name, one-liner, starting points and
// first command); then the platform picker (Picker.astro) and
// the eight highlights, each one link. The other parts go under the section
// headings in index.mdx: the lexicon link table, the lifecycle row, the
// read-next table and, last on the page, the setup prompt to hand a coding
// agent (`part="agent"`), from prompts.mjs, which README.md and the agents
// page carry too. One import keeps index.mdx's prose free of import lines.
import { readdirSync, statSync } from 'node:fs';
import { join, resolve } from 'node:path';
import Lifecycle from './Lifecycle.astro';
import LinkRows from './LinkRows.astro';
import Picker from './Picker.astro';
import ProductHome from './ProductHome.astro';
import AgentPrompt from '../../../packages/core/src/codegen/docs-site/AgentPrompt.astro';
import { setupPrompt } from '../prompts.mjs';
import { base, docsHref } from '../site';

interface Props {
	part?: 'top' | 'lexicons' | 'lifecycle' | 'next' | 'agent';
}
const { part = 'top' } = Astro.props;

// How many lexicons ship, read from lexicons/ in the repository (see data/proof.mjs).
const lexiconsDir = resolve(process.cwd(), '..', 'lexicons');
const lexiconCount = readdirSync(lexiconsDir).filter((n) => statSync(join(lexiconsDir, n)).isDirectory()).length;

const pillars = [
	{ title: 'One plan note for each change', href: '/guide/pull-request-ci/' },
	{ title: 'Approvals bound to the plan', href: '/guide/pull-request-ci/' },
	{ title: 'Merges and releases, your choice', href: '/concepts/trunk-and-releases/' },
	{ title: 'Ops with gates and rollback', href: '/guide/ops/' },
	{ title: 'Generated for GitHub, GitLab and Forgejo', href: '/cli/ci/' },
	{ title: 'Component releases, signed and verified', href: '/components/overview/' },
	{ title: 'Native specs, checked in your editor', href: '/concepts/typescript-as-data/' },
	{ title: 'Local emulators, no cloud account', href: '/local-testing/overview/' },
];
---
{part === 'lexicons' && <LinkRows set="lexicons" />}
{part === 'lifecycle' && <Lifecycle />}
{part === 'next' && <LinkRows set="next" />}
{part === 'agent' && (
	<AgentPrompt text={setupPrompt} label="Hand the setup to your coding agent" note="Or set up by hand: install a lexicon and run chant init, as Quick Start shows.">
		<span slot="icon" class="ch-logo ch-prompt-logo" aria-hidden="true"></span>
	</AgentPrompt>
)}
{part === 'top' && (
	<>
		<ProductHome id="chant">
			<a slot="art" class="hero-link" href={docsHref} aria-label="The docs"><span class="ch-logo hero-logo" aria-hidden="true"></span></a>
		</ProductHome>
		<Picker />
		<ul class="ch-pillars not-content">
			{pillars.map((p) => (
				<li>
					<a href={`${base}${p.href}`}>
						<span class="ch-logo" aria-hidden="true"></span>
						<span>{p.title}</span>
					</a>
				</li>
			))}
		</ul>
	</>
)}

<style>
	.ch-landing {
		display: grid;
		justify-items: center;
		gap: 0.9rem;
		padding-block: clamp(1.5rem, 4vw, 2.5rem) 1.25rem;
		text-align: center;
	}
	.hero-link {
		line-height: 0;
		transition: transform 0.2s;
	}
	.hero-link:hover {
		transform: translateY(-2px);
	}
	/* Three screen pixels per art pixel, so every square stays sharp. */
	/* Optical centre: the face, not the whole image, sits over the wordmark. The
	   face spans art columns 1 to 24 of the 40-wide viewBox, so its middle is 6
	   art pixels (18px) left of the image's, and the sound waves hang to the right. */
	.hero-logo {
		width: 120px;
		height: 69px;
		position: relative;
		left: 18px;
	}
	.wordmark {
		margin: 0.4rem 0 0;
		font-family: var(--ch-display);
		font-weight: 500;
		font-size: clamp(1.4rem, 3.8vw, 1.8rem);
		letter-spacing: 0.4em;
		line-height: 1;
		color: var(--sl-color-white);
	}
	/* The mark between two gold hairlines, under the wordmark. */
	.rule {
		display: flex;
		align-items: center;
		gap: 0.9rem;
	}
	.rule::before,
	.rule::after {
		content: '';
		width: 2.6rem;
		height: 1px;
		background: var(--ch-gold);
	}
	.claim {
		margin: 0;
		font-family: var(--ch-display);
		font-size: 0.78rem;
		line-height: 1.3;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 30rem) {
		.claim {
			letter-spacing: 0.14em;
		}
	}
	.lede {
		margin: 0.4rem 0 0;
		max-width: 40rem;
		font-size: var(--sl-text-lg);
		line-height: 1.5;
		color: var(--sl-color-gray-1);
		text-wrap: pretty;
	}
	.ch-pillars {
		list-style: none;
		max-width: 64rem;
		margin: 0 auto;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.75rem;
	}
	.ch-pillars li {
		margin: 0;
		min-width: 0;
	}
	.ch-pillars a {
		display: grid;
		gap: 0.75rem;
		justify-items: start;
		height: 100%;
		padding: 1.1rem 1.15rem;
		font-family: var(--ch-display);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1.3;
		color: var(--sl-color-white);
		text-decoration: none;
		border: 1px solid var(--ch-rule);
		border-top: 1px solid var(--ch-gold);
		border-radius: 0.5rem;
		background: var(--ch-panel);
		transition: border-color 0.15s;
	}
	.ch-pillars a:hover,
	.ch-pillars a:focus-visible {
		border-color: var(--ch-gold);
	}
	@media (max-width: 50rem) {
		.ch-pillars {
			grid-template-columns: repeat(2, 1fr);
			gap: 0.5rem;
		}
		.ch-pillars a {
			padding: 0.85rem;
			font-size: var(--sl-text-xs);
		}
	}
</style>
