---
import { existsSync, readdirSync, statSync } from 'node:fs';

interface Props {
  name: string;
  alt: string;
  caption?: string;
}
const { name, alt, caption } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// A lexicon page (src/content/docs/lexicons/<name>/...) shows its lexicon's
// diagrams, which scripts/build-diagrams.sh builds from
// lexicons/<name>/docs/diagrams/ into public/lexicons/<name>/diagrams/, so
// they keep the URL they had on the lexicon's own site (chant #3993).
// starlight-llms-txt renders page bodies outside a Starlight route, where
// reading `starlightRoute` throws; there the diagram is found by its file.
let entryId: string | undefined;
try {
  entryId = Astro.locals.starlightRoute?.entry.id;
} catch {
  entryId = undefined;
}
const isSection = (lex: string) => existsSync(`src/content/docs/lexicons/${lex}`) && statSync(`src/content/docs/lexicons/${lex}`).isDirectory();
const fromRoute = entryId?.match(/^lexicons\/([^/]+)/)?.[1];
const fromFile = () =>
  existsSync(`public/diagrams/${name}.svg`) || !existsSync('public/lexicons')
    ? undefined
    : readdirSync('public/lexicons').find((lex) => existsSync(`public/lexicons/${lex}/diagrams/${name}.svg`));
const lexicon = entryId === undefined ? fromFile() : fromRoute && isSection(fromRoute) ? fromRoute : undefined;
const dir = lexicon ? `lexicons/${lexicon}/diagrams` : 'diagrams';
const src = `${base}/${dir}/${name}.svg`;
const darkSrc = `${base}/${dir}/${name}-dark.svg`;
// Diagrams repainted through pinhole are baked per theme (pinhole bakes one theme
// per SVG). When a `<name>-dark.svg` exists we render both and swap on the site
// theme; single-file diagrams (graphviz, transparent) show in both.
const hasDark = existsSync(`public/${dir}/${name}-dark.svg`);
---
<figure class="diagram not-content" style="overflow-x:auto;margin:1.5rem 0;">
  {hasDark ? (
    <>
      <img class="diagram-light" src={src} alt={alt} loading="lazy" decoding="async" />
      <img class="diagram-dark" src={darkSrc} alt={alt} loading="lazy" decoding="async" />
    </>
  ) : (
    <img src={src} alt={alt} loading="lazy" decoding="async" style="display:block;max-width:100%;height:auto;margin:0 auto;" />
  )}
  {caption && <figcaption style="text-align:center;font-size:0.875rem;color:var(--sl-color-gray-3);margin-top:0.5rem;">{caption}</figcaption>}
</figure>
<style>
  .diagram img { max-width: 100%; height: auto; }
  /* Show only the theme-matched variant. Display lives on the variant classes,
   * NOT on `.diagram img` — a `.diagram img` display rule (specificity 0,1,1)
   * would outrank `.diagram-dark` (0,1,0) and leak both variants. Starlight
   * stamps data-theme on <html>. */
  .diagram-light { display: block; margin: 0 auto; }
  .diagram-dark { display: none; margin: 0 auto; }
  :global([data-theme='dark']) .diagram-light { display: none; }
  :global([data-theme='dark']) .diagram-dark { display: block; }
</style>
