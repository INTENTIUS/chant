digraph component_layers {
  rankdir=TB
  graph [fontname="Helvetica,Arial,sans-serif" bgcolor="transparent" pad="0.4" compound=true labelloc="t" fontsize=11 fontcolor="#334155"]
  node  [fontname="Helvetica,Arial,sans-serif" shape=box style="filled,rounded" margin="0.25,0.14"]

  subgraph cluster_release {
    label="Release orchestration — capabilities composed into components"
    style="rounded,filled" fillcolor="#EEF2FF" color="#4F46E5" fontcolor="#1E1B4B" margin=22

    subgraph cluster_archive {
      label="Build archive"
      style="rounded,filled" fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A" margin=20

      subgraph cluster_core {
        label="Pure synthesis"
        style="rounded,filled" fillcolor="#DCFCE7" color="#16A34A" fontcolor="#14532D" margin=16
        core [label="chant build\nTypeScript → spec-native artifacts"
              fillcolor="#FFFFFF" color="#16A34A" fontcolor="#14532D"]
      }
    }
  }
}
