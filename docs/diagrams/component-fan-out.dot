digraph component_fan_out {
  rankdir=TB
  graph [fontname="Helvetica,Arial,sans-serif" bgcolor="transparent" pad="0.4" nodesep="0.4" ranksep="0.5"]
  node  [fontname="Helvetica,Arial,sans-serif" shape=box style="filled,rounded" margin="0.22,0.12"]
  edge  [fontname="Helvetica,Arial,sans-serif" fontsize=9 fontcolor="#475569" color="#6366F1"]

  comp [label="neo4j-cluster (one component)"
        fillcolor="#F3E8FF" color="#7C3AED" fontcolor="#3B0764"]

  subgraph cluster_seed {
    label="Seed" labelloc="t" fontsize=10 fontcolor="#334155" style="rounded" color="#CBD5E1"
    s1 [label="cfn-deploy" fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A"]
    s2 [label="code-deploy" fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A"]
    s3 [label="wait-cluster-healthy" fillcolor="#FEF3C7" color="#D97706" fontcolor="#78350F"]
    s1 -> s2 -> s3
  }

  subgraph cluster_n2 {
    label="Node 2 (rolling)" labelloc="t" fontsize=10 fontcolor="#334155" style="rounded" color="#CBD5E1"
    a1 [label="cfn-deploy" fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A"]
    a2 [label="code-deploy" fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A"]
    a3 [label="wait-cluster-healthy" fillcolor="#FEF3C7" color="#D97706" fontcolor="#78350F"]
    a1 -> a2 -> a3
  }

  subgraph cluster_n3 {
    label="Node 3 (rolling)" labelloc="t" fontsize=10 fontcolor="#334155" style="rounded" color="#CBD5E1"
    b1 [label="cfn-deploy" fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A"]
    b2 [label="code-deploy" fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A"]
    b3 [label="wait-cluster-healthy" fillcolor="#FEF3C7" color="#D97706" fontcolor="#78350F"]
    b1 -> b2 -> b3
  }

  comp -> s1 [label="fan-out over instances"]
  s3 -> a1 [label="health gate"]
  a3 -> b1 [label="health gate"]
}
