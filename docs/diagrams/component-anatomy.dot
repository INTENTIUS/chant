digraph component_anatomy {
  rankdir=LR
  graph [fontname="Helvetica,Arial,sans-serif" bgcolor="transparent" pad="0.4" nodesep="0.5" ranksep="0.6"]
  node  [fontname="Helvetica,Arial,sans-serif" shape=box style="filled,rounded" margin="0.24,0.14"]
  edge  [fontname="Helvetica,Arial,sans-serif" fontsize=9 fontcolor="#475569" color="#6366F1"]

  subgraph cluster_phases {
    label="A component's deploy composition" labelloc="t" fontsize=11 fontcolor="#334155"
    style="rounded" color="#CBD5E1"
    build   [label="build\nsource → archive" fillcolor="#DCFCE7" color="#16A34A" fontcolor="#14532D"]
    publish [label="publish\npromote at deploy time" fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A"]
    apply   [label="apply\ndeploy the stack/service" fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A"]
    verify  [label="verify\nwait healthy / gate" fillcolor="#FEF3C7" color="#D97706" fontcolor="#78350F"]
    build -> publish -> apply -> verify
  }

  svc [label="Service\nbuild · publish · apply · verify"
       fillcolor="#F3E8FF" color="#7C3AED" fontcolor="#3B0764"]
  infra [label="Infra\napply · verify  (no build)"
         fillcolor="#F3E8FF" color="#7C3AED" fontcolor="#3B0764"]
  prod [label="Producer / library\nbuild · publish  (no service apply)"
        fillcolor="#F3E8FF" color="#7C3AED" fontcolor="#3B0764"]

  { rank=same; svc; infra; prod }
  verify -> svc [style=invis]
  svc -> infra [style=invis]
  infra -> prod [style=invis]
}
