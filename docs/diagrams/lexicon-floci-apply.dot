digraph lexicon_floci_apply {
  rankdir=LR
  graph [fontname="Helvetica,Arial,sans-serif" bgcolor="transparent" pad="0.5" ranksep="0.85" nodesep="0.5" compound=true]
  node  [fontname="Helvetica,Arial,sans-serif" shape=box style="filled,rounded" margin="0.2,0.12"]
  edge  [fontname="Helvetica,Arial,sans-serif" fontsize=9 fontcolor="#475569" color="#6366F1"]

  res [label="Typed resources\nnew Bucket() · StorageAccountSecure()\n· StorageBucket()"
       shape=oval fillcolor="#F3E8FF" color="#7C3AED" fontcolor="#3B0764"]

  build [label="chant build\npure: TypeScript → artifact\ntyped · linted"
         fillcolor="#DCFCE7" color="#15803D" fontcolor="#14532D"]

  art [label="Spec-native artifact\nCloudFormation · ARM · Config Connector"
       fillcolor="#DCFCE7" color="#15803D" fontcolor="#14532D"]

  subgraph cluster_apply {
    label="Native applier — Ops (no CLI shell-out)"
    style=filled fillcolor="#EFF6FF" color="#2563EB" penwidth=2
    fontname="Helvetica,Arial,sans-serif" fontcolor="#1E3A8A"
    aws [label="nativeApply\n→ CloudFormation control plane"
         fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A"]
    az  [label="azApply\n→ ARM resource CRUD"
         fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A"]
    gcp [label="gcpApply\n→ GCS · PubSub · IAM REST"
         fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A"]
  }

  endpoint [label="endpoint\noverride?"
            shape=diamond fillcolor="#FEF3C7" color="#D97706" fontcolor="#78350F" margin="0.28,0.14"]

  floci [label="Floci emulator\nfloci :4566 · floci-az :4577 · floci-gcp :4588\nlocal · no account · no cost"
         fillcolor="#F0FDFA" color="#0D9488" fontcolor="#134E4A"]

  real [label="Real cloud\nsame applier · same artifact\nonly the endpoint changes"
        fillcolor="#F1F5F9" color="#475569" fontcolor="#1E293B"]

  res -> build -> art
  art -> az [lhead=cluster_apply label="serialize"]
  aws -> endpoint [ltail=cluster_apply]
  az  -> endpoint [style=invis]
  gcp -> endpoint [style=invis]
  endpoint -> floci [label="localhost"]
  endpoint -> real  [label="cloud host (BYO creds)" style=dashed color="#94A3B8"]
}
