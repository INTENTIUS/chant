digraph supply_chain_attestations {
  rankdir=LR
  graph [fontname="Helvetica,Arial,sans-serif" bgcolor="transparent" pad="0.4" nodesep="0.45" ranksep="0.7"]
  node  [fontname="Helvetica,Arial,sans-serif" shape=box style="filled,rounded" margin="0.24,0.13"]
  edge  [fontname="Helvetica,Arial,sans-serif" fontsize=9 fontcolor="#475569" color="#6366F1"]

  build [label="build\n(image)" fillcolor="#DCFCE7" color="#16A34A" fontcolor="#14532D"]
  publish [label="publish\n→ registry, by digest" fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A"]

  subgraph cluster_digest {
    label="one artifact digest (sha256:...)" labelloc="t" fontsize=10 fontcolor="#334155" style="rounded" color="#CBD5E1"
    sbom [label="generate-sbom\nSBOM" fillcolor="#FFFFFF" color="#2563EB" fontcolor="#1E3A8A"]
    prov [label="attest-provenance\nSLSA provenance" fillcolor="#FFFFFF" color="#2563EB" fontcolor="#1E3A8A"]
    sig  [label="sign\nkeyless signature" fillcolor="#FFFFFF" color="#2563EB" fontcolor="#1E3A8A"]
  }

  verify [label="verify\nsignature + provenance\nagainst identity policy" fillcolor="#FEF3C7" color="#D97706" fontcolor="#78350F"]
  apply  [label="apply\n(deploy)" fillcolor="#FEE2E2" color="#DC2626" fontcolor="#7F1D1D"]

  build -> publish [label="digest assigned"]
  publish -> sbom
  publish -> prov
  publish -> sig
  sbom -> verify [style=invis]
  prov -> verify
  sig -> verify [label="same digest"]
  verify -> apply [label="throws on failure"]
}
