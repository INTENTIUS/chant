digraph orchestrator_modes {
  rankdir=TB
  graph [fontname="Helvetica,Arial,sans-serif" bgcolor="transparent" pad="0.4" nodesep="0.4" ranksep="0.55"]
  node  [fontname="Helvetica,Arial,sans-serif" shape=box style="filled,rounded" margin="0.24,0.13"]
  edge  [fontname="Helvetica,Arial,sans-serif" fontsize=9 fontcolor="#475569" color="#6366F1"]

  decl [label="component declarations" fillcolor="#F3E8FF" color="#7C3AED" fontcolor="#3B0764"]

  subgraph cluster_interpret {
    label="interpret mode" labelloc="t" fontsize=11 fontcolor="#334155" style="rounded" color="#CBD5E1"
    graph1 [label="chant graph --stacks\norder + waves" fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A"]
    op     [label="one orchestrator Op" fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A"]
    local  [label="local executor (default)" fillcolor="#DCFCE7" color="#16A34A" fontcolor="#14532D"]
    temporal [label="Temporal\n(gates · durable resume)" fillcolor="#EEF2FF" color="#4F46E5" fontcolor="#1E1B4B"]
    graph1 -> op
    op -> local
    op -> temporal [style=dashed label="opt-in"]
  }

  subgraph cluster_generate {
    label="generate mode" labelloc="t" fontsize=11 fontcolor="#334155" style="rounded" color="#CBD5E1"
    lex [label="github / gitlab / forgejo lexicon" fillcolor="#DBEAFE" color="#2563EB" fontcolor="#1E3A8A"]
    ci  [label="plain CI YAML\n(thin trigger + runner)" fillcolor="#DCFCE7" color="#16A34A" fontcolor="#14532D"]
    lex -> ci
  }

  decl -> graph1
  decl -> lex
}
