{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {},
    "moduleResolution": "bundler",
    "customConditions": [
      "@intentius/chant-source"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "**/*.test.ts",
    "node_modules",
    "dist",
    "docs",
    "src/cli/commands/__fixtures__/**/*",
    "src/workspace/conformance/__fixture__/**/*",
    "src/e2e-harness/__project__/**/*"
  ],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
