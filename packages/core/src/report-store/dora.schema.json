{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentius.io/chant/schemas/report-store/v1/dora.schema.json",
  "title": "chant.dora/v1",
  "description": "dora.json in a CI product's report store, beside estate.json: the four DORA metrics per member (project) and for the estate, from the workspace ledger (buildDelivery) or a product's own records (buildRecordDelivery) in @intentius/chant/ci-estate, and the release ledger's promotes and rollbacks. A product-named id (terragucci.dora/v1) is the same document, its product named by the id. Within v1 fields are only added, and an existing field never changes meaning.",
  "type": "object",
  "required": [
    "schema",
    "generated",
    "weeks",
    "window",
    "drift_window_seconds",
    "audit",
    "estate",
    "projects"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.dora/v1$",
      "description": "chant.dora/v1, or the product-named id <product>.dora/v1."
    },
    "product": {
      "type": "string",
      "description": "The product that wrote it. Required under chant.dora/v1."
    },
    "generated": {
      "type": "string",
      "description": "When the metrics were built, ISO 8601."
    },
    "weeks": {
      "type": "integer",
      "description": "How many weeks the metrics cover, the current one included."
    },
    "window": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "description": "The Monday, 00:00 UTC, the window starts on."
        },
        "to": {
          "type": "string",
          "description": "When it ends: generated."
        }
      }
    },
    "drift_window_seconds": {
      "type": "integer",
      "description": "An applied wave whose roots drift within this long counts as a failed change."
    },
    "audit": {
      "type": "boolean",
      "description": "Whether any apply record was read. Without one only drift counts."
    },
    "estate": {
      "$ref": "#/$defs/metrics"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project",
          "deployments",
          "per_week",
          "lead_time",
          "change_failure",
          "restore",
          "trend"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "deployments": {
            "type": "integer"
          },
          "per_week": {
            "type": "number"
          },
          "span_seconds": {
            "$ref": "#/$defs/span_seconds"
          },
          "lead_time": {
            "$ref": "#/$defs/lead_time"
          },
          "change_failure": {
            "$ref": "#/$defs/change_failure"
          },
          "restore": {
            "$ref": "#/$defs/restore"
          },
          "trend": {
            "$ref": "#/$defs/trend"
          },
          "releases": {
            "$ref": "#/$defs/releases"
          }
        }
      }
    },
    "source": {
      "const": "ledger",
      "description": "Present when the metrics were read from the workspace ledger."
    }
  },
  "$defs": {
    "span_seconds": {
      "type": "integer",
      "description": "What per_week divides by: from generated back to the oldest apply on record, or to the window's start when the history is older; at least a day. With no apply on record, the window's length. Absent from files written before it was added."
    },
    "seconds": {
      "type": [
        "integer",
        "null"
      ],
      "description": "A median in seconds; null when nothing counts."
    },
    "metrics": {
      "type": "object",
      "required": [
        "deployments",
        "per_week",
        "lead_time",
        "change_failure",
        "restore",
        "trend"
      ],
      "properties": {
        "deployments": {
          "type": "integer",
          "description": "Applied waves in the window."
        },
        "per_week": {
          "type": "number",
          "description": "Deployment frequency: applied waves per week over span_seconds. Files written before span_seconds divided by the whole window."
        },
        "span_seconds": {
          "$ref": "#/$defs/span_seconds"
        },
        "lead_time": {
          "$ref": "#/$defs/lead_time"
        },
        "change_failure": {
          "$ref": "#/$defs/change_failure"
        },
        "restore": {
          "$ref": "#/$defs/restore"
        },
        "trend": {
          "$ref": "#/$defs/trend"
        },
        "releases": {
          "$ref": "#/$defs/releases"
        }
      }
    },
    "lead_time": {
      "type": "object",
      "description": "From a change's first plan to its wave applied.",
      "required": [
        "changes",
        "median_seconds",
        "before_gate_seconds",
        "at_gate_seconds",
        "after_gate_seconds"
      ],
      "properties": {
        "changes": {
          "type": "integer",
          "description": "Applied waves whose first plan was found."
        },
        "median_seconds": {
          "$ref": "#/$defs/seconds"
        },
        "before_gate_seconds": {
          "$ref": "#/$defs/seconds"
        },
        "at_gate_seconds": {
          "$ref": "#/$defs/seconds"
        },
        "after_gate_seconds": {
          "$ref": "#/$defs/seconds"
        }
      }
    },
    "change_failure": {
      "type": "object",
      "required": [
        "applies",
        "failed",
        "drifted",
        "rate"
      ],
      "properties": {
        "applies": {
          "type": "integer",
          "description": "Waves that applied or failed. A refused or waiting wave is not an apply."
        },
        "failed": {
          "type": "integer"
        },
        "drifted": {
          "type": "integer",
          "description": "Applied waves whose roots drifted within drift_window_seconds."
        },
        "rate": {
          "type": [
            "number",
            "null"
          ],
          "description": "(failed + drifted) / applies; null with no applies."
        }
      }
    },
    "restore": {
      "type": "object",
      "required": [
        "restored",
        "open",
        "median_seconds",
        "apply_restored",
        "drift_restored"
      ],
      "properties": {
        "restored": {
          "type": "integer",
          "description": "Failed applies and drift restored in the window."
        },
        "open": {
          "type": "integer",
          "description": "Failed roots no apply has restored yet, and drift no check has cleared."
        },
        "median_seconds": {
          "$ref": "#/$defs/seconds"
        },
        "apply_restored": {
          "type": "integer"
        },
        "drift_restored": {
          "type": "integer"
        }
      }
    },
    "trend": {
      "type": "array",
      "description": "One row per week, oldest first.",
      "items": {
        "type": "object",
        "required": [
          "week",
          "deployments",
          "applies",
          "failures",
          "lead_time_seconds",
          "restore_seconds"
        ],
        "properties": {
          "week": {
            "type": "string",
            "description": "The Monday the week starts on, YYYY-MM-DD."
          },
          "deployments": {
            "type": "integer"
          },
          "applies": {
            "type": "integer"
          },
          "failures": {
            "type": "integer",
            "description": "Failed applies and applied waves followed by drift."
          },
          "lead_time_seconds": {
            "$ref": "#/$defs/seconds"
          },
          "restore_seconds": {
            "$ref": "#/$defs/seconds"
          },
          "promotes": {
            "type": "integer"
          },
          "rollbacks": {
            "type": "integer"
          }
        }
      }
    },
    "releases": {
      "type": "object",
      "description": "Deploy records of the release ledger in the window, by the command that wrote them. Absent when the ledger holds no deploy record.",
      "required": [
        "deploys",
        "promotes",
        "rollbacks",
        "redeploys"
      ],
      "properties": {
        "deploys": {
          "type": "integer",
          "description": "Deploys no promote, rollback or redeploy wrote."
        },
        "promotes": {
          "type": "integer"
        },
        "rollbacks": {
          "type": "integer"
        },
        "redeploys": {
          "type": "integer"
        }
      }
    }
  },
  "if": {
    "properties": {
      "schema": {
        "const": "chant.dora/v1"
      }
    }
  },
  "then": {
    "required": [
      "product"
    ]
  }
}
