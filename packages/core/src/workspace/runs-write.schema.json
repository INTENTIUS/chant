{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentius.io/chant/schemas/workspace/runs-write/v1/runs-write.schema.json",
  "title": "chant workspace runs start, end, record and sign output",
  "description": "What `chant workspace runs start|end|record|sign` print (#3033, ws-076, #3192): the run as the ledger now holds it, the Chant-Run trailer its commits carry, and where the line went on chant/lifecycle. A failure writes nothing. Version 1 of the read contract's write documents. The error codes are a closed list, each in the one closed list of `reason-codes.ts`.",
  "oneOf": [
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/failure"
    }
  ],
  "$defs": {
    "result": {
      "type": "object",
      "required": [
        "$schema",
        "contract",
        "verb",
        "run",
        "trailer",
        "ledger"
      ],
      "properties": {
        "$schema": {
          "const": "https://intentius.io/chant/schemas/workspace/runs-write/v1/runs-write.schema.json"
        },
        "contract": {
          "const": 1
        },
        "verb": {
          "enum": [
            "start",
            "end",
            "record",
            "sign"
          ]
        },
        "run": {
          "$ref": "#/$defs/run",
          "description": "The run as the ledger holds it after the write, as runs --json reports it. Its commits are the ones its end lists; runs --json adds the ones that carry its trailer."
        },
        "trailer": {
          "type": "string",
          "pattern": "^Chant-Run: ",
          "description": "The line each commit the run makes carries (#3149)."
        },
        "ledger": {
          "type": "object",
          "required": [
            "branch",
            "path",
            "commit",
            "pushed"
          ],
          "properties": {
            "branch": {
              "const": "chant/lifecycle"
            },
            "path": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "pushed": {
              "type": "boolean",
              "description": "Whether chant/lifecycle reached the remote; false with no remote too."
            },
            "notPushed": {
              "type": "string",
              "description": "Why chant/lifecycle did not reach the remote, present only when pushed is false (#3391): the repository has no remote, the remote holds commits this checkout has not fetched, or git refused the push (its first line follows)."
            }
          }
        },
        "statement": {
          "type": "object",
          "description": "For sign: the statement it stored and who signed it (#3192).",
          "required": [
            "signer",
            "class",
            "keyid",
            "envelope"
          ],
          "properties": {
            "signer": {
              "type": "string"
            },
            "class": {
              "enum": [
                "runner",
                "service"
              ]
            },
            "keyid": {
              "type": "string"
            },
            "envelope": {
              "$ref": "#/$defs/envelope"
            }
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "description": "Nothing was written. Exit code 1.",
      "required": [
        "$schema",
        "contract",
        "verb",
        "error"
      ],
      "properties": {
        "$schema": {
          "const": "https://intentius.io/chant/schemas/workspace/runs-write/v1/runs-write.schema.json"
        },
        "contract": {
          "const": 1
        },
        "verb": {
          "enum": [
            "start",
            "end",
            "record",
            "sign",
            null
          ]
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "declaration-missing",
                "declaration-ambiguous",
                "declaration-unparseable",
                "declaration-invalid",
                "placement-invalid",
                "reader-too-old",
                "root-chant-required",
                "not-a-git-repository",
                "revision-unknown",
                "write-usage-invalid",
                "write-input-invalid",
                "run-exists",
                "run-unknown",
                "run-ended",
                "run-not-ended",
                "trust-policy-unreadable",
                "runner-key-invalid",
                "runner-key-is-signer",
                "runner-key-unlisted",
                "envelope-unreadable",
                "envelope-invalid",
                "envelope-untrusted",
                "run-statement-invalid",
                "run-statement-signer-mismatch",
                "run-statement-mismatch"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "description": "One agent run, its start and end folded together.",
      "required": [
        "id",
        "state",
        "startedAt",
        "endedAt",
        "outcome",
        "by",
        "agent",
        "harness",
        "model",
        "provider",
        "unit",
        "lease",
        "records",
        "instruction",
        "usage",
        "models",
        "cost",
        "transcript",
        "commits",
        "decisions",
        "ledger",
        "record",
        "statements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The run id, the value of the Chant-Run trailer on its commits."
        },
        "state": {
          "enum": [
            "running",
            "ended"
          ],
          "description": "running until its end is recorded."
        },
        "startedAt": {
          "type": "string"
        },
        "endedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ],
          "description": "How it ended, as the writer said: done, not_done, failed, cancelled."
        },
        "by": {
          "type": [
            "string",
            "null"
          ],
          "description": "The principal the run worked for: the person who prompted it, or the service that asked."
        },
        "agent": {
          "type": [
            "string",
            "null"
          ],
          "description": "The agent session it ran as (ws-067)."
        },
        "harness": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "id",
                "kind"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ],
          "description": "The work item it worked on."
        },
        "lease": {
          "type": [
            "string",
            "null"
          ],
          "description": "The fencing token of the work lease it worked under."
        },
        "records": {
          "type": "array",
          "description": "Other records it worked on, by kind name and id.",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            }
          }
        },
        "instruction": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/pin"
            }
          ]
        },
        "usage": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/usage"
            }
          ],
          "description": "Its tokens, or null when it reported none."
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modelUsage"
          },
          "description": "Each model's share, when the harness reported a breakdown."
        },
        "cost": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/cost"
            }
          ],
          "description": "What it cost, or null when it reported no cost: never zero for unknown."
        },
        "transcript": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/pin"
            }
          ],
          "description": "The transcript, pinned by hash; never stored."
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sha",
              "patchId",
              "joinedBy"
            ],
            "properties": {
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40,64}$"
              },
              "patchId": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "git patch-id --stable, or null for a commit with no patch."
              },
              "joinedBy": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "record",
                    "trailer"
                  ]
                },
                "description": "record: the run's end lists it. trailer: it carries Chant-Run with the run's id, on HEAD's history."
              },
              "hunks": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/hunk"
                    }
                  }
                ],
                "description": "The hunks of the commit the run's end says it wrote, or null when it gives none, and the run is then taken to have made the whole commit (#3034). graph --intent uses them to name which of several runs sharing a commit wrote a line. Added within version 1, so an older document may lack it."
              }
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The decisions it carried out, as <kind>/<id>: the ones its work item implements and the decision records it names."
        },
        "ledger": {
          "type": "string",
          "description": "Its file on chant/lifecycle."
        },
        "record": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "sha256"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ],
          "description": "The SHA-256 a statement signs: of the canonical JSON of [start line, end line]. Null until the run ends (#3192)."
        },
        "statements": {
          "type": "array",
          "description": "The signed statements the ledger holds for the run, oldest first (#3192).",
          "items": {
            "type": "object",
            "required": [
              "at",
              "envelope"
            ],
            "properties": {
              "at": {
                "type": "string"
              },
              "envelope": {
                "$ref": "#/$defs/envelope"
              }
            }
          }
        },
        "attestation": {
          "$ref": "#/$defs/attestation",
          "description": "Its statements judged against the runner keys at base. Present on runs sign."
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "amount",
        "currency",
        "source"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217, such as USD."
        },
        "source": {
          "type": "string",
          "description": "What priced it, as the writer names it: a harness's own report (harness:claude-code), a proxy's price table (lobby:list-2026-09), a provider's bill."
        }
      }
    },
    "pin": {
      "type": "object",
      "description": "A file pinned by hash and never copied.",
      "required": [
        "sha256",
        "bytes",
        "ref"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Its size, when chant hashed the file itself; null when the writer gave the hash."
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where the writer keeps it, as the writer named it. chant never reads it back."
        },
        "excerpt": {
          "type": "string",
          "maxLength": 500,
          "description": "On the instruction only, and only when the writer gave one (#3034): a short excerpt to show beside the hash, such as its first line. The hash pins the whole instruction; the excerpt is the writer's and is never checked against it. Added within version 1."
        }
      }
    },
    "usage": {
      "type": "object",
      "required": [
        "turns",
        "inputTokens",
        "outputTokens",
        "cacheReadTokens",
        "cacheWriteTokens"
      ],
      "properties": {
        "turns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cacheReadTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cacheWriteTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "modelUsage": {
      "type": "object",
      "required": [
        "model",
        "provider",
        "inputTokens",
        "outputTokens",
        "cacheReadTokens",
        "cacheWriteTokens",
        "cost"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cacheReadTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cacheWriteTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/cost"
            }
          ]
        }
      }
    },
    "hunk": {
      "type": "object",
      "description": "Lines of one file a run wrote in a commit (#3034): new-side line numbers in the commit's own version of the file.",
      "required": [
        "path",
        "start",
        "end"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "From the repository root, as git names it in the commit's diff."
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "envelope": {
      "type": "object",
      "description": "A DSSE v1 envelope (https://github.com/secure-systems-lab/dsse).",
      "required": [
        "payloadType",
        "payload",
        "signatures"
      ],
      "properties": {
        "payloadType": {
          "type": "string"
        },
        "payload": {
          "type": "string",
          "description": "Base64 of the payload bytes."
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "keyid",
              "sig"
            ],
            "properties": {
              "keyid": {
                "type": "string",
                "description": "The signing key's ssh fingerprint, SHA256:..."
              },
              "sig": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "statement": {
      "type": "object",
      "description": "An in-toto Statement v1 with chant's agent-run predicate (#3192, ws-090).",
      "required": [
        "_type",
        "subject",
        "predicateType",
        "predicate"
      ],
      "properties": {
        "_type": {
          "const": "https://in-toto.io/Statement/v1"
        },
        "subject": {
          "type": "array",
          "description": "The commits the run made, sorted by id.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "digest"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "The commit id."
              },
              "digest": {
                "type": "object",
                "required": [
                  "gitCommit"
                ],
                "properties": {
                  "gitCommit": {
                    "type": "string"
                  }
                }
              },
              "annotations": {
                "type": "object",
                "properties": {
                  "patchId": {
                    "type": "string",
                    "description": "git patch-id --stable of the commit."
                  }
                }
              }
            }
          }
        },
        "predicateType": {
          "const": "https://intentius.io/chant/agent-run/v1"
        },
        "predicate": {
          "type": "object",
          "required": [
            "signer",
            "run",
            "unit",
            "harness",
            "model",
            "provider",
            "by"
          ],
          "properties": {
            "signer": {
              "type": "string",
              "description": "The runner principal whose key signs: the one .chant/trust.json lists for that key."
            },
            "run": {
              "type": "object",
              "required": [
                "id",
                "record"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "record": {
                  "type": "object",
                  "required": [
                    "sha256"
                  ],
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            },
            "unit": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "id",
                    "kind"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              ]
            },
            "harness": {
              "type": "object",
              "required": [
                "name",
                "version"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "by": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "statementVerdict": {
      "type": "object",
      "description": "One stored statement, judged against the runner keys at base and the run's record.",
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "mismatch",
            "untrusted",
            "invalid"
          ],
          "description": "verified: a listed runner key signed it and it matches the record. mismatch: a listed key signed it and it does not match. untrusted: no listed key signed it. invalid: not a DSSE envelope, not an agent-run statement, or naming another signer."
        },
        "code": {
          "enum": [
            "envelope-invalid",
            "envelope-untrusted",
            "run-statement-invalid",
            "run-statement-signer-mismatch",
            "run-statement-mismatch"
          ],
          "description": "Why it does not verify. Absent when verified."
        },
        "reason": {
          "type": "string"
        },
        "signer": {
          "type": "string"
        },
        "class": {
          "enum": [
            "runner",
            "service"
          ]
        },
        "keyid": {
          "type": "string"
        },
        "statement": {
          "$ref": "#/$defs/statement",
          "description": "The statement, when verified."
        }
      }
    },
    "attestation": {
      "type": "object",
      "description": "The run's statements judged against the runner keys at base (#3192).",
      "required": [
        "status",
        "signer",
        "class",
        "keyid",
        "code",
        "reason",
        "commits",
        "statements"
      ],
      "properties": {
        "status": {
          "enum": [
            "signed",
            "unsigned",
            "mismatch",
            "untrusted",
            "invalid"
          ],
          "description": "signed: a stored statement verifies. unsigned: the ledger holds none. Otherwise the best failure, mismatch before untrusted before invalid."
        },
        "signer": {
          "type": [
            "string",
            "null"
          ]
        },
        "class": {
          "enum": [
            "runner",
            "service",
            null
          ]
        },
        "keyid": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "envelope-invalid",
                "envelope-untrusted",
                "run-statement-invalid",
                "run-statement-signer-mismatch",
                "run-statement-mismatch"
              ]
            }
          ],
          "description": "The code of the failure status reports, or null when signed or unsigned."
        },
        "reason": {
          "type": "string"
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The commits the verified statement names. Empty unless signed."
        },
        "statements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statementVerdict"
          },
          "description": "One verdict per stored statement, in ledger order."
        }
      }
    }
  }
}
