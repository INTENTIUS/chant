{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentius.io/chant/schemas/workspace/ls/v1/ls.schema.json",
  "title": "chant workspace ls output",
  "description": "What `chant workspace ls --json` prints, version 1 of the read contract for listing a workspace (#2524 D15, #2534). Readers ignore fields they do not know; a field is only ever added within a version. The reason and error codes are closed lists: a new code is a new contract version.",
  "oneOf": [{ "$ref": "#/$defs/result" }, { "$ref": "#/$defs/failure" }],
  "$defs": {
    "result": {
      "description": "The declaration was read. Exit code 0, even when some members can't be read.",
      "type": "object",
      "required": ["$schema", "contract", "chant", "at", "workspace", "members", "groups", "summary"],
      "properties": {
        "$schema": { "const": "https://intentius.io/chant/schemas/workspace/ls/v1/ls.schema.json" },
        "contract": { "const": 1 },
        "chant": { "type": "string", "description": "The version of the chant that read the workspace." },
        "at": {
          "description": "The full commit id the workspace was read at (--at), or null for the working tree.",
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "error": false,
        "workspace": {
          "type": "object",
          "required": ["name", "root", "file", "schema", "minReader", "pins"],
          "properties": {
            "name": { "type": "string", "description": "The declared name. With the revision, it identifies the workspace." },
            "root": {
              "type": "string",
              "description": "The workspace root relative to the git root, with / separators, \".\" for the git root itself. An absolute path outside a git repository."
            },
            "file": { "enum": ["chant.workspace.json", "chant.workspace.jsonc"] },
            "schema": { "const": 1 },
            "minReader": { "type": ["string", "null"] },
            "pins": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["package", "version", "path", "integrity"],
                "properties": {
                  "package": { "type": ["string", "null"] },
                  "version": { "type": ["string", "null"] },
                  "path": { "type": ["string", "null"] },
                  "integrity": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "members": {
          "description": "Every member, in declaration order, readable or not.",
          "type": "array",
          "items": { "$ref": "#/$defs/member" }
        },
        "groups": {
          "description": "Every example group (ws-051), in declaration order. Their matches are not members.",
          "type": "array",
          "items": { "$ref": "#/$defs/group" }
        },
        "summary": {
          "type": "object",
          "required": ["members", "unreadable", "groups", "matches"],
          "properties": {
            "members": { "type": "integer", "minimum": 0 },
            "unreadable": { "type": "integer", "minimum": 0, "description": "Members with a reason." },
            "groups": { "type": "integer", "minimum": 0 },
            "matches": { "type": "integer", "minimum": 0, "description": "Projects across all groups." }
          }
        }
      }
    },
    "member": {
      "type": "object",
      "required": ["name", "dir", "kind", "roles", "upstream", "because", "readable", "reason"],
      "properties": {
        "name": { "type": "string" },
        "dir": { "type": "string", "description": "Relative to the workspace root, with / separators; \".\" is the root member." },
        "kind": { "type": "string" },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "path"],
            "properties": {
              "name": { "type": "string" },
              "path": { "type": ["string", "null"], "description": "Relative to the member's directory, or null for the whole member." }
            }
          }
        },
        "upstream": { "type": ["string", "null"] },
        "because": { "type": ["string", "null"] },
        "readable": { "type": "boolean", "description": "True exactly when reason is null." },
        "reason": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["code", "message"],
              "properties": {
                "code": { "enum": ["dir-missing", "unknown-kind", "kind-probe-failed"] },
                "message": { "type": "string" }
              }
            }
          ]
        }
      },
      "if": { "type": "object", "properties": { "readable": { "const": true } }, "required": ["readable"] },
      "then": { "type": "object", "properties": { "reason": { "type": "null" } } },
      "else": { "type": "object", "properties": { "reason": { "type": "object" } } }
    },
    "group": {
      "type": "object",
      "required": ["name", "kind", "glob", "matches", "skipped", "reason"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "const": "examples" },
        "glob": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "matches": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Directories the globs match that hold a chant project, relative to the workspace root, sorted. They are built and linted, and nothing else."
        },
        "skipped": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Directories the globs match that hold no chant project. They are left alone."
        },
        "reason": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["code", "message"],
              "properties": {
                "code": { "enum": ["no-matches"] },
                "message": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "failure": {
      "description": "The declaration could not be read, and nothing is listed. Exit code 1.",
      "type": "object",
      "required": ["$schema", "contract", "chant", "error"],
      "properties": {
        "$schema": { "const": "https://intentius.io/chant/schemas/workspace/ls/v1/ls.schema.json" },
        "contract": { "const": 1 },
        "chant": { "type": "string" },
        "error": {
          "type": "object",
          "required": ["code", "message", "location"],
          "properties": {
            "code": {
              "enum": [
                "declaration-missing",
                "declaration-ambiguous",
                "declaration-unparseable",
                "declaration-invalid",
                "placement-invalid",
                "reader-too-old",
                "not-a-git-repository",
                "revision-unknown"
              ]
            },
            "message": { "type": "string" },
            "location": {
              "description": "Where in the declaration the problem is, or null when it is not in the file.",
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["file", "line", "column"],
                  "properties": {
                    "file": { "type": "string" },
                    "line": { "type": "integer", "minimum": 1 },
                    "column": { "type": "integer", "minimum": 1 }
                  }
                }
              ]
            }
          }
        },
        "members": false,
        "workspace": false
      }
    }
  }
}
