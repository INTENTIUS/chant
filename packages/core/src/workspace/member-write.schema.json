{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentius.io/chant/schemas/workspace/member-write/v1/member-write.schema.json",
  "title": "chant workspace member add|remove and host set output",
  "description": "What `chant workspace member add <name> --from <file|->`, `member remove <name>` and `host set <name> --from <file|->` print (#3596): the entry before and after the write and the file it changed, or the reason it wrote nothing. Each write changes one entry of members or hosts in the declaration, in place, keeping the file's formatting and comments, and never commits. Readers ignore fields they do not know; a field is only ever added within a version. The error codes are a closed list, each in the one closed list of `reason-codes.ts`. Contract version 1 of this document is written by chant 0.110.0 and newer.",
  "oneOf": [
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/failure"
    }
  ],
  "$defs": {
    "result": {
      "description": "The entry was written, or would be with --dry-run, or the declaration already held it (changed false). Exit code 0.",
      "type": "object",
      "required": [
        "$schema",
        "contract",
        "chant",
        "action",
        "name",
        "declaration",
        "paths",
        "changed",
        "dryRun",
        "previous",
        "entry"
      ],
      "properties": {
        "$schema": {
          "const": "https://intentius.io/chant/schemas/workspace/member-write/v1/member-write.schema.json"
        },
        "contract": {
          "const": 1
        },
        "chant": {
          "type": "string",
          "description": "The chant that wrote it."
        },
        "action": {
          "enum": [
            "member add",
            "member remove",
            "host set"
          ]
        },
        "name": {
          "type": "string",
          "description": "The member's or host's name."
        },
        "declaration": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "The declaration file, relative to the repository root (the working directory outside git), with / separators."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "The sha256 of the declaration's bytes after the write, or as they would be with --dry-run."
            }
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The declaration, relative to the repository root, when the write changed it or would with --dry-run; empty when it already held what was given."
        },
        "changed": {
          "type": "boolean",
          "description": "Whether the declaration changed: paths is not empty."
        },
        "dryRun": {
          "type": "boolean",
          "description": "True when --dry-run was given: nothing was written, and the document says what would have been."
        },
        "previous": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ],
          "description": "The entry before the write, as the declaration held it, x- keys included; null when member add or host set adds a new one."
        },
        "entry": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                }
              }
            }
          ],
          "description": "The entry after the write, as the declaration holds it, with name first; null after member remove."
        }
      }
    },
    "failure": {
      "type": "object",
      "description": "Nothing was written. Exit code 1.",
      "required": [
        "$schema",
        "contract",
        "chant",
        "action",
        "name",
        "error"
      ],
      "properties": {
        "$schema": {
          "const": "https://intentius.io/chant/schemas/workspace/member-write/v1/member-write.schema.json"
        },
        "contract": {
          "const": 1
        },
        "chant": {
          "type": "string"
        },
        "action": {
          "enum": [
            "member add",
            "member remove",
            "host set"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "declaration-missing",
                "declaration-ambiguous",
                "declaration-unparseable",
                "declaration-invalid",
                "placement-invalid",
                "reader-too-old",
                "root-chant-required",
                "not-a-git-repository",
                "revision-unknown",
                "write-usage-invalid",
                "write-input-invalid",
                "member-exists",
                "member-unknown",
                "box-isolation-collision",
                "box-isolation-literal",
                "write-scope-member",
                "write-scope-protected",
                "write-scope-class-unknown",
                "agent-unknown",
                "principal-unidentified",
                "write-lock-timeout",
                "write-lock-not-held"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
