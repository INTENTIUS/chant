{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentius.io/chant/schemas/workspace/ci-last-green/v1/ci-last-green.schema.json",
  "title": "chant ci last-green output",
  "description": "What `chant ci last-green --json` prints (#3573, ws-103): the newest first-parent commit of the branch ci.green names that has a ci/green/<sha> tag and no ci/revoked/<sha> tag. It reads local refs and tags and never fetches. Version 1 of the read contract. Readers ignore fields they do not know; a field is only ever added within a version. The codes are a closed list, each in the one closed list of `reason-codes.ts`. Contract version 1 of this document is written by chant 0.108.0 and newer; the read contract as a whole by chant 0.81.0 and newer.",
  "oneOf": [
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/failure"
    }
  ],
  "$defs": {
    "result": {
      "type": "object",
      "description": "Exit code 0, with or without a green commit.",
      "required": [
        "$schema",
        "contract",
        "chant",
        "workspace",
        "branch",
        "ref",
        "commit"
      ],
      "properties": {
        "$schema": {
          "const": "https://intentius.io/chant/schemas/workspace/ci-last-green/v1/ci-last-green.schema.json"
        },
        "contract": {
          "const": 1
        },
        "chant": {
          "type": "string"
        },
        "error": false,
        "workspace": {
          "type": "object",
          "required": [
            "name",
            "root",
            "file"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "root": {
              "type": "string",
              "description": "The workspace root relative to the git root, with / separators, \".\" for the git root itself."
            },
            "file": {
              "enum": [
                "chant.workspace.json",
                "chant.workspace.jsonc"
              ]
            }
          }
        },
        "branch": {
          "type": "string",
          "description": "ci.green.branch."
        },
        "ref": {
          "type": "string",
          "description": "The ref whose first-parent commits were walked: refs/remotes/origin/<branch> when the checkout has it, else refs/heads/<branch>, or the revision --from names (#4031)."
        },
        "commit": {
          "description": "The newest green commit that is not revoked, or null when there is none. Only tags that count are read: with ci.green.signedSince set, a tag on a commit that is not a strict first-parent ancestor of it counts only with a valid statement signed by a runner key (#4031).",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "sha",
                "tag",
                "tagged",
                "committed"
              ],
              "properties": {
                "sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40,64}$"
                },
                "tag": {
                  "type": "string",
                  "description": "ci/green/<sha>."
                },
                "tagged": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "When the green tag was made, ISO 8601, or null for a lightweight tag."
                },
                "committed": {
                  "type": "string",
                  "description": "The commit's committer time, ISO 8601."
                }
              }
            }
          ]
        },
        "newer": {
          "type": "array",
          "description": "Added within contract version 1 by #4169, written by chant 0.124.33 and newer. The first-parent commits walked past, newest first and above the one found, each with what its _ci/<sha>.json record on the local chant/lifecycle says (null when it has none), so a reader can say why the newest commits are not green. At most 50.",
          "items": {
            "type": "object",
            "required": [
              "sha",
              "record"
            ],
            "properties": {
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40,64}$"
              },
              "record": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": [
                      "state"
                    ],
                    "properties": {
                      "state": {
                        "enum": [
                          "green",
                          "red",
                          "unbuilt",
                          "pending"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      },
                      "coveredBy": {
                        "type": "string"
                      },
                      "culprit": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "ignored": {
          "type": "array",
          "description": "Added within contract version 1 by #4031, written by chant 0.124.28 and newer. The tags on the commits walked, newest first and down to the one found, that do not count for want of a valid statement. Empty when ci.green.signedSince is not set.",
          "items": {
            "type": "object",
            "required": [
              "tag",
              "status",
              "reason"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "description": "ci/green/<sha> or ci/revoked/<sha>."
              },
              "status": {
                "enum": [
                  "unsigned",
                  "invalid",
                  "untrusted",
                  "mismatch"
                ],
                "description": "unsigned: the annotation carries no statement. invalid: the statement is not a ci-tag statement, or names another signer than the key's. untrusted: no runner key .chant/trust.json lists at base signed it, or its principal holds no runner role. mismatch: it signs another commit, tag kind or branch, the annotation's record is not the one signed, or the tag points at another commit than its name gives."
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "description": "Nothing was read. Exit code 1.",
      "required": [
        "$schema",
        "contract",
        "chant",
        "error"
      ],
      "properties": {
        "$schema": {
          "const": "https://intentius.io/chant/schemas/workspace/ci-last-green/v1/ci-last-green.schema.json"
        },
        "contract": {
          "const": 1
        },
        "chant": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "declaration-missing",
                "declaration-ambiguous",
                "declaration-unparseable",
                "declaration-invalid",
                "placement-invalid",
                "reader-too-old",
                "root-chant-required",
                "not-a-git-repository",
                "revision-unknown",
                "ci-green-undeclared",
                "ci-branch-unknown"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
