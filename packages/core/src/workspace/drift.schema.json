{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentius.io/chant/schemas/workspace/drift/v1/drift.schema.json",
  "title": "drift document",
  "description": "One drift record per resource instance, across engines (#4451): which read answered and what it found, with drifted attribute paths, an ownership facet and the engine's own token. Written by driftDocument in @intentius/chant/drift-record. Ephemeral and bound to no gate. A state read is never in-sync or drifted, and not-observed always carries a reason. The NDJSON stream's lines are in $defs: drift-start, drift-record and drift-settle. Readers ignore fields they do not know; a field is only ever added within a version.",
  "type": "object",
  "required": [
    "$schema",
    "drift",
    "records",
    "counts"
  ],
  "properties": {
    "$schema": {
      "const": "https://intentius.io/chant/schemas/workspace/drift/v1/drift.schema.json"
    },
    "drift": {
      "const": "v1"
    },
    "contract": {
      "type": "integer",
      "const": 1,
      "description": "The read-contract version, on the document chant workspace drift prints (behold#995). Absent from a document driftDocument builds on its own."
    },
    "member": {
      "type": "string",
      "description": "The member chant workspace drift read."
    },
    "chant": {
      "type": "string",
      "description": "The chant that wrote the document."
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "description": "Sorted by member, address and read; one per (member, address, read)."
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "declaration-missing",
            "declaration-ambiguous",
            "declaration-unparseable",
            "declaration-invalid",
            "placement-invalid",
            "reader-too-old",
            "root-chant-required",
            "not-a-git-repository",
            "revision-unknown",
            "member-required",
            "no-drift-read",
            "read-unsupported",
            "resource-unsupported",
            "env-required",
            "command-failed"
          ],
          "description": "Why the read could not run: a declaration code, or one of the read's own (DRIFT_ERROR_CODES in drift-cli.ts)."
        },
        "message": {
          "type": "string"
        }
      },
      "description": "On chant workspace drift's document when the read could not run. records is then empty."
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "description": "One resource instance as one read saw it.",
      "required": [
        "member",
        "engine",
        "address",
        "node",
        "observedAt",
        "read",
        "status",
        "evidence"
      ],
      "properties": {
        "member": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "enum": [
            "terraform",
            "tofu",
            "choudoufu",
            "chant",
            "warden",
            "sql",
            "pulumi",
            "plunge"
          ]
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "description": "The engine's own address, at instance level: aws_eip.pool[0], a Pulumi URN, a chant entity name."
        },
        "resourceType": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": [
            "string",
            "null"
          ],
          "description": "The graph node, by the change set's mapping rules (graphNodeFor): the instance node <blockNode>[0] or <blockNode>[\"a\"] for an instance of a count or for_each block, the block node otherwise. Null when the graph holds none, and for a Pulumi URN until a URN-to-graph rule exists."
        },
        "instanceOf": {
          "type": "string",
          "minLength": 1,
          "description": "On a record whose node is an instance node: the block node it is an instance of."
        },
        "observedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$",
          "description": "RFC 3339."
        },
        "read": {
          "enum": [
            "state",
            "plan",
            "refresh",
            "live-read",
            "ownership"
          ]
        },
        "fellBackFrom": {
          "type": "string",
          "minLength": 1,
          "description": "The read that was asked for and failed, when this one answered instead."
        },
        "status": {
          "enum": [
            "in-sync",
            "drifted",
            "pending",
            "missing",
            "unclaimed",
            "undeclared",
            "runtime",
            "recorded",
            "not-observed"
          ]
        },
        "unobserved": {
          "$ref": "#/$defs/unobserved"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribute"
          },
          "description": "What differs, sorted by path. Only on drifted."
        },
        "attributesUnobserved": {
          "$ref": "#/$defs/unobserved",
          "description": "Presence is known and the attributes are not. Only on in-sync or drifted."
        },
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "read": {
                "const": "state"
              }
            },
            "required": [
              "read"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "recorded",
                  "pending",
                  "not-observed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not-observed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "unobserved"
            ],
            "properties": {
              "unobserved": {
                "$ref": "#/$defs/unobserved"
              }
            }
          },
          "else": {
            "properties": {
              "unobserved": false
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "status": {
                  "const": "drifted"
                }
              }
            }
          },
          "then": {
            "properties": {
              "attributes": false
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "status": {
                  "enum": [
                    "in-sync",
                    "drifted"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "attributesUnobserved": false
            }
          }
        }
      ]
    },
    "attribute": {
      "type": "object",
      "required": [
        "path"
      ],
      "description": "before is what was expected (the record, the snapshot, the declaration), after what the read found. A sensitive attribute carries neither.",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "before": {},
        "after": {},
        "sensitive": {
          "const": true
        }
      },
      "if": {
        "required": [
          "sensitive"
        ],
        "properties": {
          "sensitive": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "before": false,
          "after": false
        }
      }
    },
    "unobserved": {
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "enum": [
            "read-failed",
            "no-credentials",
            "no-binding",
            "unsupported-kind",
            "filtered",
            "not-reached"
          ]
        },
        "detail": {
          "type": "string"
        },
        "queried": {
          "type": "string",
          "description": "The address the read was issued against, when the engine reported one."
        }
      }
    },
    "ownership": {
      "type": "object",
      "required": [
        "verdict"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "owned",
            "foreign",
            "adoptable",
            "unknown"
          ]
        },
        "by": {
          "enum": [
            "marker",
            "derived",
            "record",
            "cache",
            "state",
            "label"
          ]
        },
        "markerOnObject": {
          "type": "boolean"
        },
        "ownedBy": {
          "type": "string"
        },
        "adopt": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "tool"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "engineCode": {
          "type": "string",
          "description": "The engine's own token for the verdict, such as UNOWNED, NEEDS_DISCOVERY or ABSENT."
        }
      }
    },
    "counts": {
      "type": "object",
      "description": "Records per status, every status present.",
      "required": [
        "in-sync",
        "drifted",
        "pending",
        "missing",
        "unclaimed",
        "undeclared",
        "runtime",
        "recorded",
        "not-observed"
      ],
      "properties": {
        "in-sync": {
          "type": "integer",
          "minimum": 0
        },
        "drifted": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "unclaimed": {
          "type": "integer",
          "minimum": 0
        },
        "undeclared": {
          "type": "integer",
          "minimum": 0
        },
        "runtime": {
          "type": "integer",
          "minimum": 0
        },
        "recorded": {
          "type": "integer",
          "minimum": 0
        },
        "not-observed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "expected": {
      "type": "object",
      "required": [
        "address"
      ],
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "resourceType": {
          "type": "string"
        },
        "instanceOf": {
          "type": "string"
        }
      }
    },
    "startLine": {
      "type": "object",
      "description": "Opens a member's read.",
      "required": [
        "type",
        "drift",
        "member",
        "engine",
        "read",
        "expected"
      ],
      "properties": {
        "type": {
          "const": "drift-start"
        },
        "drift": {
          "const": "v1"
        },
        "member": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "enum": [
            "terraform",
            "tofu",
            "choudoufu",
            "chant",
            "warden",
            "sql",
            "pulumi",
            "plunge"
          ]
        },
        "read": {
          "enum": [
            "state",
            "plan",
            "refresh",
            "live-read",
            "ownership"
          ]
        },
        "resource": {
          "type": "string",
          "description": "The one address a single-resource read was asked about."
        },
        "fellBackFrom": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$",
          "description": "RFC 3339."
        },
        "expected": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/expected"
              }
            ]
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "recordLine": {
      "type": "object",
      "description": "One record as its read finishes: the record's fields beside type. A later line for the same (member, address, read) replaces it.",
      "allOf": [
        {
          "$ref": "#/$defs/record"
        }
      ],
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "drift-record"
        }
      }
    },
    "settleLine": {
      "type": "object",
      "description": "Closes a member's read. Every expected address no record answered is not-observed with reason not-reached.",
      "required": [
        "type",
        "drift",
        "member",
        "engine",
        "read",
        "counts"
      ],
      "properties": {
        "type": {
          "const": "drift-settle"
        },
        "drift": {
          "const": "v1"
        },
        "member": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "enum": [
            "terraform",
            "tofu",
            "choudoufu",
            "chant",
            "warden",
            "sql",
            "pulumi",
            "plunge"
          ]
        },
        "read": {
          "enum": [
            "state",
            "plan",
            "refresh",
            "live-read",
            "ownership"
          ]
        },
        "counts": {
          "type": "object",
          "description": "Records per status; a status with none may be left out.",
          "additionalProperties": false,
          "properties": {
            "in-sync": {
              "type": "integer",
              "minimum": 0
            },
            "drifted": {
              "type": "integer",
              "minimum": 0
            },
            "pending": {
              "type": "integer",
              "minimum": 0
            },
            "missing": {
              "type": "integer",
              "minimum": 0
            },
            "unclaimed": {
              "type": "integer",
              "minimum": 0
            },
            "undeclared": {
              "type": "integer",
              "minimum": 0
            },
            "runtime": {
              "type": "integer",
              "minimum": 0
            },
            "recorded": {
              "type": "integer",
              "minimum": 0
            },
            "not-observed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "reads": {
          "type": "object",
          "description": "The engine's own account of what the read cost, such as choudoufu's recordsRead and sweepCalls. Carried, never interpreted."
        },
        "at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$",
          "description": "RFC 3339."
        },
        "notReached": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "line": {
      "oneOf": [
        {
          "$ref": "#/$defs/startLine"
        },
        {
          "$ref": "#/$defs/recordLine"
        },
        {
          "$ref": "#/$defs/settleLine"
        }
      ]
    }
  }
}
