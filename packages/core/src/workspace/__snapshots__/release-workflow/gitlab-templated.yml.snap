# ==== after ====
chant-release-publish:
  rules:
    - if: $CI_COMMIT_TAG =~ /^v[A-Za-z0-9._+-]+$/ && $CI_COMMIT_TAG !~ /^v[0-9]+$/
  id_tokens:
