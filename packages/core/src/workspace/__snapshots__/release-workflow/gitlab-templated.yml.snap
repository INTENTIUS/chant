# ==== artifacts with goreleaser ====
chant-release-publish:
  rules:
    - if: $CI_COMMIT_TAG =~ /^v[A-Za-z0-9._+-]+$/ && $CI_COMMIT_TAG !~ /^v[0-9]+$/
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "npm ci"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "label=\"$(npx chant release tag \"$CI_COMMIT_TAG\" --json | node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.label??\"\"))')\" || label=\"\""
    - "if [ -z \"$label\" ]; then echo \"$CI_COMMIT_TAG names no release of this member, so nothing is published\" >&2; exit 1; fi"
    - "export CHANT_RELEASE_LABEL=\"$label\""
    - "case \"$(uname -m)\" in x86_64|amd64) mkdir -p \"/tmp/goreleaser\" && curl -fsSL -o \"/tmp/goreleaser/goreleaser.tar.gz\" https://github.com/goreleaser/goreleaser/releases/download/v2.19.0/goreleaser_Linux_x86_64.tar.gz && echo \"ebc3194ad1d1b1787614405285a0039665cd4c5bd3305215a1b201600f90630b  /tmp/goreleaser/goreleaser.tar.gz\" | sha256sum -c - && tar -xzf \"/tmp/goreleaser/goreleaser.tar.gz\" -C \"/tmp/goreleaser\" goreleaser;; aarch64|arm64) mkdir -p \"/tmp/goreleaser\" && curl -fsSL -o \"/tmp/goreleaser/goreleaser.tar.gz\" https://github.com/goreleaser/goreleaser/releases/download/v2.19.0/goreleaser_Linux_arm64.tar.gz && echo \"ef33741b684c9f62d6a21e7a3c8b051f139ea7b1d301693b67cc819c46226d53  /tmp/goreleaser/goreleaser.tar.gz\" | sha256sum -c - && tar -xzf \"/tmp/goreleaser/goreleaser.tar.gz\" -C \"/tmp/goreleaser\" goreleaser;; *) echo \"no pinned goreleaser v2.19.0 build for $(uname -m)\" >&2; exit 1;; esac && export CHANT_GORELEASER=/tmp/goreleaser/goreleaser"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "npx chant release artifacts \"$CHANT_RELEASE_LABEL\""
    - "npm run build"
    - "npx chant release publish \"$CHANT_RELEASE_LABEL\" --yes"

# ==== signing ====
chant-release-publish:
  rules:
    - if: $CI_COMMIT_TAG =~ /^v[A-Za-z0-9._+-]+$/ && $CI_COMMIT_TAG !~ /^v[0-9]+$/
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "npm ci"
    - "case \"$(uname -m)\" in x86_64|amd64) curl -fsSL -o \"/tmp/cosign\" https://github.com/sigstore/cosign/releases/download/v3.1.4/cosign-linux-amd64 && echo \"424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa  /tmp/cosign\" | sha256sum -c - && chmod +x \"/tmp/cosign\";; aarch64|arm64) curl -fsSL -o \"/tmp/cosign\" https://github.com/sigstore/cosign/releases/download/v3.1.4/cosign-linux-arm64 && echo \"ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2  /tmp/cosign\" | sha256sum -c - && chmod +x \"/tmp/cosign\";; *) echo \"no pinned cosign v3.1.4 build for $(uname -m)\" >&2; exit 1;; esac && export CHANT_COSIGN=/tmp/cosign"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "label=\"$(npx chant release tag \"$CI_COMMIT_TAG\" --json | node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.label??\"\"))')\" || label=\"\""
    - "if [ -z \"$label\" ]; then echo \"$CI_COMMIT_TAG names no release of this member, so nothing is published\" >&2; exit 1; fi"
    - "export CHANT_RELEASE_LABEL=\"$label\""
    - "npm run build"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "npx chant release publish \"$CHANT_RELEASE_LABEL\" --yes"

