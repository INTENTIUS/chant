    - "export CHANT_RELEASE_LABEL=\"$label\""
    - npm run announce
    - echo done

# ==== env and setup ====
chant-release-publish:
  rules:
    - if: $CI_COMMIT_TAG =~ /^v[A-Za-z0-9._+-]+$/ && $CI_COMMIT_TAG !~ /^v[0-9]+$/
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  variables:
    OCI_USERNAME: "bot"
  script:
    - "npm ci"
    - "echo setup"
    - "export A=\"1\""
    - "echo named"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "label=\"$(npx chant release tag \"$CI_COMMIT_TAG\" --json | node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.label??\"\"))')\" || label=\"\""
    - "if [ -z \"$label\" ]; then echo \"$CI_COMMIT_TAG names no release of this member, so nothing is published\" >&2; exit 1; fi"
    - "export CHANT_RELEASE_LABEL=\"$label\""
    - "npm run build"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "npx chant release publish \"$CHANT_RELEASE_LABEL\" --yes"

# ==== permissions ====
chant-release-publish:
  rules:
    - if: $CI_COMMIT_TAG =~ /^v[A-Za-z0-9._+-]+$/ && $CI_COMMIT_TAG !~ /^v[0-9]+$/
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "npm ci"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "label=\"$(npx chant release tag \"$CI_COMMIT_TAG\" --json | node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.label??\"\"))')\" || label=\"\""
    - "if [ -z \"$label\" ]; then echo \"$CI_COMMIT_TAG names no release of this member, so nothing is published\" >&2; exit 1; fi"
    - "export CHANT_RELEASE_LABEL=\"$label\""
    - "npm run build"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "npx chant release publish \"$CHANT_RELEASE_LABEL\" --yes"

