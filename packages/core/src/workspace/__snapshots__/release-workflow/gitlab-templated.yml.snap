    - "label=\"$(npx chant release tag \"$CI_COMMIT_TAG\" --json | node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.label??\"\"))')\" || label=\"\""
