    - "export CHANT_RELEASE_LABEL=\"$CHANT_RELEASE_NEXT\""
    - "git checkout --detach \"$CHANT_RELEASE_COMMIT\""
    - "mv \"$CI_PROJECT_DIR/.chant-release-artifacts\" /tmp/chant-release-artifacts"
    - "npm ci"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "chant_auth=\"$(printf 'oauth2:%s' \"$CHANT_RELEASE_TOKEN\" | base64 | tr -d '\\n')\""
    - "export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraheader GIT_CONFIG_VALUE_0=\"AUTHORIZATION: basic $chant_auth\""
    - "unset chant_auth"
    - "npm run build"
    - "npx chant release artifacts \"$CHANT_RELEASE_LABEL\" --from /tmp/chant-release-artifacts"
    - "npx chant release publish \"$CHANT_RELEASE_LABEL\" --yes"

# ==== artifacts with goreleaser ====
chant-release-gate:
  rules:
    - if: $CHANT_RELEASE_LABEL && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
  artifacts:
    reports:
      dotenv: chant-release-gate.env
  script:
    - "npm ci"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "commit=\"$(npx chant ci last-green --from \"$CI_COMMIT_SHA\" --json | node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.commit?.sha??\"\"))')\""
    - "if [ -z \"$commit\" ]; then echo \"no green commit at or below $CI_COMMIT_SHA, so no release is cut\" >&2; exit 1; fi"
    - "label=\"$CHANT_RELEASE_LABEL\"; if [ \"$label\" = auto ]; then rc=0; git ls-remote --exit-code --heads origin chant/lifecycle >/dev/null || rc=$?; if [ \"$rc\" = 0 ]; then git fetch origin chant/lifecycle:chant/lifecycle; elif [ \"$rc\" != 2 ]; then exit \"$rc\"; fi; next=\"$(npx chant release next --at \"$commit\" --json)\" || { echo \"release next found no label for $commit, so no release is cut: $next\" >&2; exit 1; }; label=\"$(printf '%s' \"$next\" | node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.label??\"\"))')\"; fi"
    - "printf 'CHANT_RELEASE_COMMIT=%s\\nCHANT_RELEASE_NEXT=%s\\n' \"$commit\" \"$label\" > \"$CI_PROJECT_DIR/chant-release-gate.env\""

chant-release-cut:
  rules:
    - if: $CHANT_RELEASE_LABEL && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
  needs: [chant-release-gate]
  artifacts:
    paths:
      - ".chant-release-artifacts/"
    expire_in: 1 day
  script:
    - "export CHANT_RELEASE_LABEL=\"$CHANT_RELEASE_NEXT\""
    - "git checkout --detach \"$CHANT_RELEASE_COMMIT\""
    - "npm ci"
    - "mkdir -p \"/tmp/goreleaser\" && curl -fsSL -o \"/tmp/goreleaser/goreleaser.tar.gz\" https://github.com/goreleaser/goreleaser/releases/download/v2.19.0/goreleaser_Linux_x86_64.tar.gz && echo \"ebc3194ad1d1b1787614405285a0039665cd4c5bd3305215a1b201600f90630b  /tmp/goreleaser/goreleaser.tar.gz\" | sha256sum -c - && tar -xzf \"/tmp/goreleaser/goreleaser.tar.gz\" -C \"/tmp/goreleaser\" goreleaser && export CHANT_GORELEASER=/tmp/goreleaser/goreleaser"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "chant_auth=\"$(printf 'oauth2:%s' \"$CHANT_RELEASE_TOKEN\" | base64 | tr -d '\\n')\""
    - "export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraheader GIT_CONFIG_VALUE_0=\"AUTHORIZATION: basic $chant_auth\""
    - "unset chant_auth"
    - "rc=0; git ls-remote --exit-code --heads origin chant/lifecycle >/dev/null || rc=$?; if [ \"$rc\" = 0 ]; then git fetch origin chant/lifecycle:chant/lifecycle; elif [ \"$rc\" != 2 ]; then exit \"$rc\"; fi"
    - "npx chant release doctor --from cut"
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant release cut \"$CHANT_RELEASE_LABEL\" --at \"$CHANT_RELEASE_COMMIT\" --yes --build 'npm run build' --json > /tmp/chant-cut.json"
    - "tag=\"$(node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.tag?.name??\"\"))' /tmp/chant-cut.json)\""
    - "if [ -n \"$tag\" ]; then git push origin \"refs/tags/$tag\"; fi"
    - "npx chant release artifacts \"$CHANT_RELEASE_LABEL\" --no-build -o \"$CI_PROJECT_DIR/.chant-release-artifacts\""

chant-release-publish:
  rules:
    - if: $CHANT_RELEASE_LABEL && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
  needs: [chant-release-gate, chant-release-cut]
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "export CHANT_RELEASE_LABEL=\"$CHANT_RELEASE_NEXT\""
    - "git checkout --detach \"$CHANT_RELEASE_COMMIT\""
    - "mv \"$CI_PROJECT_DIR/.chant-release-artifacts\" /tmp/chant-release-artifacts"
    - "npm ci"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "chant_auth=\"$(printf 'oauth2:%s' \"$CHANT_RELEASE_TOKEN\" | base64 | tr -d '\\n')\""
    - "export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraheader GIT_CONFIG_VALUE_0=\"AUTHORIZATION: basic $chant_auth\""
    - "unset chant_auth"
    - "npm run build"
    - "npx chant release artifacts \"$CHANT_RELEASE_LABEL\" --from /tmp/chant-release-artifacts"
    - "npx chant release publish \"$CHANT_RELEASE_LABEL\" --yes"

