    - "tar -xkf chant-release-build-arm.tar"
    - "mv chant-release-build-arm.tar /tmp/"
    - "tar -xkf chant-release-build-mac.tar"
    - "mv chant-release-build-mac.tar /tmp/"
    - "npx chant release doctor --from cut"
