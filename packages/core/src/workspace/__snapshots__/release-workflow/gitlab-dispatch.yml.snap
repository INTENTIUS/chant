    - "npx chant release doctor --from cut"
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant release cut \"$CHANT_RELEASE_LABEL\" --at \"$CHANT_RELEASE_COMMIT\" --yes --json > /tmp/chant-cut.json"
    - "tag=\"$(node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.tag?.name??\"\"))' /tmp/chant-cut.json)\""
    - "if [ -n \"$tag\" ]; then git push origin \"refs/tags/$tag\"; fi"

chant-release-publish:
  rules:
    - if: $CHANT_RELEASE_LABEL && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
  needs: [chant-release-gate, chant-release-cut]
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "export CHANT_RELEASE_LABEL=\"$CHANT_RELEASE_NEXT\""
    - "git checkout --detach \"$CHANT_RELEASE_COMMIT\""
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "chant_auth=\"$(printf 'oauth2:%s' \"$CHANT_RELEASE_TOKEN\" | base64 | tr -d '\\n')\""
    - "export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraheader GIT_CONFIG_VALUE_0=\"AUTHORIZATION: basic $chant_auth\""
    - "unset chant_auth"
    - "npx chant release publish \"$CHANT_RELEASE_LABEL\" --yes"

