    - "npm run build"
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant workspace train publish npm \"$CHANT_RELEASE_TRAIN\" --require-provenance --yes"

# ==== signing ====
chant-release-gate:
  rules:
    - if: $CHANT_RELEASE_LEVELS && ($CHANT_RELEASE_TRAIN == null || $CHANT_RELEASE_TRAIN == "") && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
  artifacts:
    reports:
      dotenv: chant-release-gate.env
  script:
    - "npm ci"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "commit=\"$(npx chant ci last-green --from \"$CI_COMMIT_SHA\" --json | node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.commit?.sha??\"\"))')\""
    - "if [ -z \"$commit\" ]; then echo \"no green commit at or below $CI_COMMIT_SHA, so no release is cut\" >&2; exit 1; fi"
    - "printf 'CHANT_RELEASE_COMMIT=%s\\n' \"$commit\" > \"$CI_PROJECT_DIR/chant-release-gate.env\""

chant-release-cut:
  rules:
    - if: $CHANT_RELEASE_LEVELS && ($CHANT_RELEASE_TRAIN == null || $CHANT_RELEASE_TRAIN == "") && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
  needs: [chant-release-gate]
  artifacts:
    reports:
      dotenv: chant-release-train.env
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "git checkout --detach \"$CHANT_RELEASE_COMMIT\""
    - "npm ci"
    - "curl -fsSL -o \"/tmp/cosign\" https://github.com/sigstore/cosign/releases/download/v3.1.4/cosign-linux-amd64 && echo \"424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa  /tmp/cosign\" | sha256sum -c - && chmod +x \"/tmp/cosign\" && export CHANT_COSIGN=/tmp/cosign"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "chant_auth=\"$(printf 'oauth2:%s' \"$CHANT_RELEASE_TOKEN\" | base64 | tr -d '\\n')\""
    - "export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraheader GIT_CONFIG_VALUE_0=\"AUTHORIZATION: basic $chant_auth\""
    - "unset chant_auth"
    - "rc=0; git ls-remote --exit-code --heads origin chant/lifecycle >/dev/null || rc=$?; if [ \"$rc\" = 0 ]; then git fetch origin chant/lifecycle:chant/lifecycle; elif [ \"$rc\" != 2 ]; then exit \"$rc\"; fi"
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant workspace train cut npm --at \"$CHANT_RELEASE_COMMIT\" --levels \"${CHANT_RELEASE_LEVELS:-auto}\" --doctor --yes --json > /tmp/chant-train.json"
    - "train=\"$(node -e 'const t=require(\"fs\").readFileSync(process.argv[1],\"utf8\");let d;try{d=JSON.parse(t)}catch(e){const m=/\"id\": *\"(train-[^\"]+)\"/.exec(t);console.error(\"the train cut printed more than its JSON document, so the train id can not be read (\"+e.message+\").\"+(m?\" The cut recorded \"+m[1]+\": run a pipeline with CHANT_RELEASE_TRAIN=\"+m[1]+\" to publish it.\":\" If it recorded a train, run a pipeline with CHANT_RELEASE_TRAIN=<id> to publish it.\"));process.exit(1)}const id=d.train?.id??\"\";if(!id&&d.released==null&&(d.members??[]).length>0){console.error(\"the train cut \"+d.members.length+\" member(s), and its JSON names no train id to publish\");process.exit(1)}process.stdout.write(id)' \"/tmp/chant-train.json\")\" || exit 1"
    - "printf 'CHANT_TRAIN_CUT=%s\\n' \"$train\" > \"$CI_PROJECT_DIR/chant-release-train.env\""

chant-release-publish:
  rules:
    - if: $CHANT_RELEASE_TRAIN && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
    - if: $CHANT_RELEASE_LEVELS && ($CHANT_RELEASE_TRAIN == null || $CHANT_RELEASE_TRAIN == "") && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
  needs:
    - job: chant-release-cut
      optional: true
  resource_group: chant-release
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "export CHANT_RELEASE_TRAIN=\"${CHANT_RELEASE_TRAIN:-${CHANT_TRAIN_CUT:-${CI_COMMIT_TAG#release-train/npm/}}}\""
    - "if [ -z \"$CHANT_RELEASE_TRAIN\" ]; then echo \"no release train was cut or named, so there is nothing to publish\"; exit 0; fi"
    - "git fetch origin \"refs/tags/release-train/npm/$CHANT_RELEASE_TRAIN\""
    - "git checkout --detach FETCH_HEAD"
    - "npm ci"
    - "curl -fsSL -o \"/tmp/cosign\" https://github.com/sigstore/cosign/releases/download/v3.1.4/cosign-linux-amd64 && echo \"424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa  /tmp/cosign\" | sha256sum -c - && chmod +x \"/tmp/cosign\" && export CHANT_COSIGN=/tmp/cosign"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "chant_auth=\"$(printf 'oauth2:%s' \"$CHANT_RELEASE_TOKEN\" | base64 | tr -d '\\n')\""
    - "export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraheader GIT_CONFIG_VALUE_0=\"AUTHORIZATION: basic $chant_auth\""
    - "unset chant_auth"
    - "npx chant workspace train prepare npm \"$CHANT_RELEASE_TRAIN\""
    - "npm run build"
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant workspace train publish npm \"$CHANT_RELEASE_TRAIN\" --yes"

# ==== lane ====
chant-release-gate:
  rules:
    - if: $CHANT_RELEASE_LEVELS && ($CHANT_RELEASE_TRAIN == null || $CHANT_RELEASE_TRAIN == "") && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
  artifacts:
    reports:
      dotenv: chant-release-gate.env
  script:
    - "npm ci"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "commit=\"$(npx chant ci last-green --from \"$CI_COMMIT_SHA\" --lane fast --json | node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.commit?.sha??\"\"))')\""
    - "if [ -z \"$commit\" ]; then echo \"no green commit at or below $CI_COMMIT_SHA, so no release is cut\" >&2; exit 1; fi"
    - "printf 'CHANT_RELEASE_COMMIT=%s\\n' \"$commit\" > \"$CI_PROJECT_DIR/chant-release-gate.env\""

chant-release-cut:
  rules:
    - if: $CHANT_RELEASE_LEVELS && ($CHANT_RELEASE_TRAIN == null || $CHANT_RELEASE_TRAIN == "") && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
  needs: [chant-release-gate]
  artifacts:
    reports:
      dotenv: chant-release-train.env
  script:
    - "git checkout --detach \"$CHANT_RELEASE_COMMIT\""
    - "npm ci"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "chant_auth=\"$(printf 'oauth2:%s' \"$CHANT_RELEASE_TOKEN\" | base64 | tr -d '\\n')\""
    - "export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraheader GIT_CONFIG_VALUE_0=\"AUTHORIZATION: basic $chant_auth\""
    - "unset chant_auth"
    - "rc=0; git ls-remote --exit-code --heads origin chant/lifecycle >/dev/null || rc=$?; if [ \"$rc\" = 0 ]; then git fetch origin chant/lifecycle:chant/lifecycle; elif [ \"$rc\" != 2 ]; then exit \"$rc\"; fi"
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant workspace train cut npm --at \"$CHANT_RELEASE_COMMIT\" --levels \"${CHANT_RELEASE_LEVELS:-auto}\" --doctor --yes --json > /tmp/chant-train.json"
    - "train=\"$(node -e 'const t=require(\"fs\").readFileSync(process.argv[1],\"utf8\");let d;try{d=JSON.parse(t)}catch(e){const m=/\"id\": *\"(train-[^\"]+)\"/.exec(t);console.error(\"the train cut printed more than its JSON document, so the train id can not be read (\"+e.message+\").\"+(m?\" The cut recorded \"+m[1]+\": run a pipeline with CHANT_RELEASE_TRAIN=\"+m[1]+\" to publish it.\":\" If it recorded a train, run a pipeline with CHANT_RELEASE_TRAIN=<id> to publish it.\"));process.exit(1)}const id=d.train?.id??\"\";if(!id&&d.released==null&&(d.members??[]).length>0){console.error(\"the train cut \"+d.members.length+\" member(s), and its JSON names no train id to publish\");process.exit(1)}process.stdout.write(id)' \"/tmp/chant-train.json\")\" || exit 1"
    - "printf 'CHANT_TRAIN_CUT=%s\\n' \"$train\" > \"$CI_PROJECT_DIR/chant-release-train.env\""

chant-release-publish:
  rules:
    - if: $CHANT_RELEASE_TRAIN && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
    - if: $CHANT_RELEASE_LEVELS && ($CHANT_RELEASE_TRAIN == null || $CHANT_RELEASE_TRAIN == "") && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
  needs:
    - job: chant-release-cut
      optional: true
  resource_group: chant-release
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "export CHANT_RELEASE_TRAIN=\"${CHANT_RELEASE_TRAIN:-${CHANT_TRAIN_CUT:-${CI_COMMIT_TAG#release-train/npm/}}}\""
    - "if [ -z \"$CHANT_RELEASE_TRAIN\" ]; then echo \"no release train was cut or named, so there is nothing to publish\"; exit 0; fi"
    - "git fetch origin \"refs/tags/release-train/npm/$CHANT_RELEASE_TRAIN\""
    - "git checkout --detach FETCH_HEAD"
    - "npm ci"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "chant_auth=\"$(printf 'oauth2:%s' \"$CHANT_RELEASE_TOKEN\" | base64 | tr -d '\\n')\""
    - "export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraheader GIT_CONFIG_VALUE_0=\"AUTHORIZATION: basic $chant_auth\""
    - "unset chant_auth"
    - "npx chant workspace train prepare npm \"$CHANT_RELEASE_TRAIN\""
    - "npm run build"
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant workspace train publish npm \"$CHANT_RELEASE_TRAIN\" --yes"

# ==== gate head ====
chant-release-gate:
  rules:
    - if: $CHANT_RELEASE_LEVELS && ($CHANT_RELEASE_TRAIN == null || $CHANT_RELEASE_TRAIN == "") && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
  artifacts:
    reports:
      dotenv: chant-release-gate.env
  script:
    - "npm ci"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "commit=\"$(npx chant ci last-green --from \"$CI_COMMIT_SHA\" --json | node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.commit?.sha??\"\"))')\""
    - "if [ -z \"$commit\" ]; then echo \"no green commit at or below $CI_COMMIT_SHA, so no release is cut\" >&2; exit 1; fi"
    - "if [ \"$commit\" != \"$CI_COMMIT_SHA\" ]; then echo \"$CI_COMMIT_SHA is not green (the newest green commit below it is $commit), so no release is cut\" >&2; exit 1; fi"
