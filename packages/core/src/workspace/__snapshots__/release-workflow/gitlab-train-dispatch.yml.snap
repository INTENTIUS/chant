# ==== member builds ====
chant-release-gate:
  rules:
    - if: $CHANT_RELEASE_LEVELS && ($CHANT_RELEASE_TRAIN == null || $CHANT_RELEASE_TRAIN == "") && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
  artifacts:
    reports:
      dotenv: chant-release-gate.env
  script:
    - "cd release"
    - "npm ci"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "commit=\"$(npx chant ci last-green --from \"$CI_COMMIT_SHA\" --json | node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.commit?.sha??\"\"))')\""
    - "if [ -z \"$commit\" ]; then echo \"no green commit at or below $CI_COMMIT_SHA, so no release is cut\" >&2; exit 1; fi"
    - "printf 'CHANT_RELEASE_COMMIT=%s\\n' \"$commit\" > \"$CI_PROJECT_DIR/chant-release-gate.env\""
    - "npx chant workspace train cut npm --at \"$commit\" --levels \"${CHANT_RELEASE_LEVELS:-auto}\" --plan-only --json > /tmp/chant-train-plan.json"
    - "printf 'CHANT_TRAIN_PLANNED=%s\\n' \"$(node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.planned??\"\"))' /tmp/chant-train-plan.json)\" >> \"$CI_PROJECT_DIR/chant-release-gate.env\""
    - "printf 'CHANT_TRAIN_LABEL_CLI_ARM=%s\\n' \"$(node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.members.find((m)=>m.member===\"cli\")?.label??\"\"))' /tmp/chant-train-plan.json)\" >> \"$CI_PROJECT_DIR/chant-release-gate.env\""
    - "printf 'CHANT_TRAIN_LABEL_WEB_MAC=%s\\n' \"$(node -e 'const f=process.argv[1];const t=f?require(\"fs\").readFileSync(f,\"utf8\"):require(\"fs\").readFileSync(0,\"utf8\");const d=JSON.parse(t);process.stdout.write(String(d.members.find((m)=>m.member===\"web\")?.label??\"\"))' /tmp/chant-train-plan.json)\" >> \"$CI_PROJECT_DIR/chant-release-gate.env\""

chant-release-build-cli-arm:
  rules:
    - if: $CHANT_RELEASE_LEVELS && ($CHANT_RELEASE_TRAIN == null || $CHANT_RELEASE_TRAIN == "") && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
    GOARCH: "arm64"
  needs: [chant-release-gate]
  tags: ["arm64"]
  artifacts:
    paths:
      - "release/packages/cli/chant-release-build-cli-arm.tar"
    expire_in: 1 day
  script:
    - "export CHANT_RELEASE_LABEL=\"$CHANT_TRAIN_LABEL_CLI_ARM\""
    - "if [ -z \"$CHANT_RELEASE_LABEL\" ]; then echo \"cli is not in this train, so build-cli-arm builds nothing\"; exit 0; fi"
    - "git checkout --detach \"$CHANT_RELEASE_COMMIT\""
    - "cd release"
    - "npm ci"
    - "cd packages/cli"
    - "make"
    - "tar -cf chant-release-build-cli-arm.tar -- dist/cli"

chant-release-build-web-mac:
  rules:
    - if: $CHANT_RELEASE_LEVELS && ($CHANT_RELEASE_TRAIN == null || $CHANT_RELEASE_TRAIN == "") && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
  needs: [chant-release-gate]
  tags: ["macos-14"]
  artifacts:
    paths:
      - "release/packages/web/chant-release-build-web-mac.tar"
    expire_in: 1 day
  script:
    - "export CHANT_RELEASE_LABEL=\"$CHANT_TRAIN_LABEL_WEB_MAC\""
    - "if [ -z \"$CHANT_RELEASE_LABEL\" ]; then echo \"web is not in this train, so build-web-mac builds nothing\"; exit 0; fi"
    - "git checkout --detach \"$CHANT_RELEASE_COMMIT\""
    - "cd release"
    - "cd packages/web"
    - "make deps"
    - "make mac"
    - "tar -cf chant-release-build-web-mac.tar -- dist/mac"

chant-release-cut:
  rules:
    - if: $CHANT_RELEASE_LEVELS && ($CHANT_RELEASE_TRAIN == null || $CHANT_RELEASE_TRAIN == "") && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
  needs: [chant-release-gate, chant-release-build-cli-arm, chant-release-build-web-mac]
  artifacts:
    paths:
      - ".chant-release-artifacts/"
    expire_in: 1 day
    reports:
      dotenv: chant-release-train.env
  script:
    - "git checkout --detach \"$CHANT_RELEASE_COMMIT\""
    - "cd release"
    - "npm ci"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "chant_auth=\"$(printf 'oauth2:%s' \"$CHANT_RELEASE_TOKEN\" | base64 | tr -d '\\n')\""
    - "export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraheader GIT_CONFIG_VALUE_0=\"AUTHORIZATION: basic $chant_auth\""
    - "unset chant_auth"
    - "rc=0; git ls-remote --exit-code --heads origin chant/lifecycle >/dev/null || rc=$?; if [ \"$rc\" = 0 ]; then git fetch origin chant/lifecycle:chant/lifecycle; elif [ \"$rc\" != 2 ]; then exit \"$rc\"; fi"
    - "if [ -n \"$CHANT_TRAIN_LABEL_CLI_ARM\" ]; then tar -xkf packages/cli/chant-release-build-cli-arm.tar -C packages/cli; mv packages/cli/chant-release-build-cli-arm.tar /tmp/; fi"
    - "if [ -n \"$CHANT_TRAIN_LABEL_WEB_MAC\" ]; then tar -xkf packages/web/chant-release-build-web-mac.tar -C packages/web; mv packages/web/chant-release-build-web-mac.tar /tmp/; fi"
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant workspace train cut npm --at \"$CHANT_RELEASE_COMMIT\" --levels \"${CHANT_RELEASE_LEVELS:-auto}\" --planned \"$CHANT_TRAIN_PLANNED\" --doctor --yes --json > /tmp/chant-train.json"
    - "train=\"$(node -e 'const t=require(\"fs\").readFileSync(process.argv[1],\"utf8\");let d;try{d=JSON.parse(t)}catch(e){const m=/\"id\": *\"(train-[^\"]+)\"/.exec(t);console.error(\"the train cut printed more than its JSON document, so the train id can not be read (\"+e.message+\").\"+(m?\" The cut recorded \"+m[1]+\": run a pipeline with CHANT_RELEASE_TRAIN=\"+m[1]+\" to publish it.\":\" If it recorded a train, run a pipeline with CHANT_RELEASE_TRAIN=<id> to publish it.\"));process.exit(1)}const id=d.train?.id??\"\";if(!id&&d.released==null&&(d.members??[]).length>0){console.error(\"the train cut \"+d.members.length+\" member(s), and its JSON names no train id to publish\");process.exit(1)}process.stdout.write(id)' \"/tmp/chant-train.json\")\" || exit 1"
    - "printf 'CHANT_TRAIN_CUT=%s\\n' \"$train\" > \"$CI_PROJECT_DIR/chant-release-train.env\""
    - "if [ -n \"$train\" ]; then npx chant workspace train artifacts npm \"$train\" -o \"$CI_PROJECT_DIR/.chant-release-artifacts\"; fi"

chant-release-publish:
  rules:
    - if: $CHANT_RELEASE_TRAIN && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
    - if: $CHANT_RELEASE_LEVELS && ($CHANT_RELEASE_TRAIN == null || $CHANT_RELEASE_TRAIN == "") && $CI_PIPELINE_SOURCE =~ /^(web|api|trigger)$/
  variables:
    GIT_DEPTH: "0"
  needs:
    - job: chant-release-cut
      optional: true
    - job: chant-release-build-cli-arm
      optional: true
    - job: chant-release-build-web-mac
      optional: true
  resource_group: chant-release
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "if [ -d \"$CI_PROJECT_DIR/.chant-release-artifacts\" ]; then mv \"$CI_PROJECT_DIR/.chant-release-artifacts\" /tmp/chant-release-artifacts; fi"
    - "export CHANT_RELEASE_TRAIN=\"${CHANT_RELEASE_TRAIN:-${CHANT_TRAIN_CUT:-${CI_COMMIT_TAG#release-train/npm/}}}\""
    - "if [ -z \"$CHANT_RELEASE_TRAIN\" ]; then echo \"no release train was cut or named, so there is nothing to publish\"; exit 0; fi"
    - "git fetch origin \"refs/tags/release-train/npm/$CHANT_RELEASE_TRAIN\""
    - "git checkout --detach FETCH_HEAD"
    - "cd release"
    - "npm ci"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "chant_auth=\"$(printf 'oauth2:%s' \"$CHANT_RELEASE_TOKEN\" | base64 | tr -d '\\n')\""
    - "export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraheader GIT_CONFIG_VALUE_0=\"AUTHORIZATION: basic $chant_auth\""
    - "unset chant_auth"
    - "if [ -f packages/cli/chant-release-build-cli-arm.tar ]; then tar -xf packages/cli/chant-release-build-cli-arm.tar -C packages/cli; mv packages/cli/chant-release-build-cli-arm.tar /tmp/; fi"
    - "if [ -f packages/web/chant-release-build-web-mac.tar ]; then tar -xf packages/web/chant-release-build-web-mac.tar -C packages/web; mv packages/web/chant-release-build-web-mac.tar /tmp/; fi"
    - "npx chant workspace train prepare npm \"$CHANT_RELEASE_TRAIN\""
    - "npm run build"
    - "npx chant workspace train artifacts npm \"$CHANT_RELEASE_TRAIN\" --from /tmp/chant-release-artifacts"
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant workspace train publish npm \"$CHANT_RELEASE_TRAIN\" --yes"

# ==== member builds named twice ====
throws: release.workflow.builds: arm is named twice (a train runs every member's builds in one workflow, so each job name is used once across the members)
