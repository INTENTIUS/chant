# ==== member root ====
name: chant release train
on:
  push:
    tags: ["release-train/npm/*"]
permissions:
  contents: write
  id-token: write
concurrency:
  group: chant-release
  cancel-in-progress: false
jobs:
  publish:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: release
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - run: git fetch origin chant/lifecycle:chant/lifecycle
      - run: echo "CHANT_RELEASE_TRAIN=${CHANT_RELEASE_TRAIN:-${GITHUB_REF_NAME#release-train/npm/}}" >> "$GITHUB_ENV"
      - run: npx chant workspace train prepare npm "$CHANT_RELEASE_TRAIN"
      - run: npm run build
      - run: git config user.name "chant release"
      - run: git config user.email "chant-release@localhost"
      - run: npx chant workspace train publish npm "$CHANT_RELEASE_TRAIN" --yes

# ==== supply-chain ====
name: chant release train
on:
  push:
    tags: ["release-train/npm/*"]
permissions:
  contents: write
  id-token: write
concurrency:
  group: chant-release
  cancel-in-progress: false
jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - run: git fetch origin chant/lifecycle:chant/lifecycle
      - run: echo "CHANT_RELEASE_TRAIN=${CHANT_RELEASE_TRAIN:-${GITHUB_REF_NAME#release-train/npm/}}" >> "$GITHUB_ENV"
      - run: npx chant workspace train prepare npm "$CHANT_RELEASE_TRAIN"
      - run: npm run build
      - run: git config user.name "chant release"
      - run: git config user.email "chant-release@localhost"
      - run: npx chant workspace train publish npm "$CHANT_RELEASE_TRAIN" --require-provenance --yes

# ==== signing ====
name: chant release train
on:
  push:
    tags: ["release-train/npm/*"]
permissions:
  contents: write
  id-token: write
concurrency:
  group: chant-release
  cancel-in-progress: false
jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - name: "Install cosign v3.1.4"
        run: "curl -fsSL -o \"$RUNNER_TEMP/cosign\" https://github.com/sigstore/cosign/releases/download/v3.1.4/cosign-linux-amd64 && echo \"424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa  $RUNNER_TEMP/cosign\" | sha256sum -c - && chmod +x \"$RUNNER_TEMP/cosign\" && echo \"CHANT_COSIGN=$RUNNER_TEMP/cosign\" >> \"$GITHUB_ENV\""
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - run: git fetch origin chant/lifecycle:chant/lifecycle
      - run: echo "CHANT_RELEASE_TRAIN=${CHANT_RELEASE_TRAIN:-${GITHUB_REF_NAME#release-train/npm/}}" >> "$GITHUB_ENV"
      - run: npx chant workspace train prepare npm "$CHANT_RELEASE_TRAIN"
      - run: npm run build
      - run: git config user.name "chant release"
      - run: git config user.email "chant-release@localhost"
      - run: npx chant workspace train publish npm "$CHANT_RELEASE_TRAIN" --yes

