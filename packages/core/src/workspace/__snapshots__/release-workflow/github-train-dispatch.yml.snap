# ==== doctor off ====
name: chant release train
on:
  workflow_dispatch:
    inputs:
      levels:
        description: auto for the levels the commits and intent files give, a level for every member (major, minor or patch), or <member>=<level>, separated by spaces
        required: false
        default: auto
        type: string
      train:
        description: a recorded train's id (train-...) to publish instead of cutting one; the gate and cut are skipped, and the publish resumes from its tag
        required: false
        default: ""
        type: string
  push:
    tags: ["release-train/npm/*"]
permissions:
  contents: read
concurrency:
  group: chant-release
  cancel-in-progress: false
jobs:
  gate:
    if: github.event_name == 'workflow_dispatch' && inputs.train == ''
    runs-on: ubuntu-latest
    permissions:
      contents: read
    outputs:
      commit: ${{ steps.green.outputs.commit }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - id: green
        run: |
          commit="$(npx chant ci last-green --from "$GITHUB_SHA" --json | node -e 'const f=process.argv[1];const t=f?require("fs").readFileSync(f,"utf8"):require("fs").readFileSync(0,"utf8");const d=JSON.parse(t);process.stdout.write(String(d.commit?.sha??""))')"
          if [ -z "$commit" ]; then echo "no green commit at or below $GITHUB_SHA, so no release is cut" >&2; exit 1; fi
          if ! git diff --quiet "$commit" "$GITHUB_SHA" -- ":(top).github/workflows"; then
            changed="$(git log -1 --format=%H "$commit..$GITHUB_SHA" -- ":(top).github/workflows")"
            echo "the newest green commit, $commit, has other workflow files than $GITHUB_SHA, and GitHub refuses this job's token a tag on it, so no release is cut. Dispatch again once ${changed:-$GITHUB_SHA}, which changed .github/workflows, or a commit after it is green." >&2
            exit 1
          fi
          echo "commit=$commit" >> "$GITHUB_OUTPUT"
  cut:
    needs: gate
    runs-on: ubuntu-latest
    permissions:
      contents: write
    outputs:
      train: ${{ steps.cut.outputs.train }}
    env:
      CHANT_RELEASE_COMMIT: ${{ needs.gate.outputs.commit }}
      CHANT_RELEASE_LEVELS: ${{ inputs.levels }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          ref: ${{ needs.gate.outputs.commit }}
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - run: rc=0; git ls-remote --exit-code --heads origin chant/lifecycle >/dev/null || rc=$?; if [ "$rc" = 0 ]; then git fetch origin chant/lifecycle:chant/lifecycle; elif [ "$rc" != 2 ]; then exit "$rc"; fi
      - id: cut
        run: |
          git config user.name "chant release"
          git config user.email "chant-release@localhost"
          npx chant workspace train cut npm --at "$CHANT_RELEASE_COMMIT" --levels "${CHANT_RELEASE_LEVELS:-auto}" --yes --json > "$RUNNER_TEMP/chant-train.json"
          train="$(node -e 'const t=require("fs").readFileSync(process.argv[1],"utf8");let d;try{d=JSON.parse(t)}catch(e){const m=/"id": *"(train-[^"]+)"/.exec(t);console.error("the train cut printed more than its JSON document, so the train id can not be read ("+e.message+")."+(m?" The cut recorded "+m[1]+": dispatch this workflow with train="+m[1]+" to publish it.":" If it recorded a train, dispatch this workflow with train=<id> to publish it."));process.exit(1)}const id=d.train?.id??"";if(!id&&d.released==null&&(d.members??[]).length>0){console.error("the train cut "+d.members.length+" member(s), and its JSON names no train id to publish");process.exit(1)}process.stdout.write(id)' "$RUNNER_TEMP/chant-train.json")" || exit 1
          echo "train=$train" >> "$GITHUB_OUTPUT"
  publish:
    needs: [gate, cut]
    if: ${{ always() && (github.event_name == 'push' || (github.event_name == 'workflow_dispatch' && inputs.train != '') || (needs.cut.result == 'success' && needs.cut.outputs.train != '')) }}
    runs-on: ubuntu-latest
    permissions:
      contents: write
      id-token: write
    env:
      CHANT_RELEASE_TRAIN: ${{ inputs.train || needs.cut.outputs.train }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          ref: ${{ needs.gate.outputs.commit || (inputs.train != '' && format('refs/tags/release-train/npm/{0}', inputs.train)) || github.sha }}
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - run: git fetch origin chant/lifecycle:chant/lifecycle
      - run: echo "CHANT_RELEASE_TRAIN=${CHANT_RELEASE_TRAIN:-${GITHUB_REF_NAME#release-train/npm/}}" >> "$GITHUB_ENV"
      - run: npx chant workspace train prepare npm "$CHANT_RELEASE_TRAIN"
      - run: npm run build
      - run: git config user.name "chant release"
      - run: git config user.email "chant-release@localhost"
      - run: npx chant workspace train publish npm "$CHANT_RELEASE_TRAIN" --yes

# ==== member builds ====
name: chant release train
on:
  workflow_dispatch:
    inputs:
      levels:
        description: auto for the levels the commits and intent files give, a level for every member (major, minor or patch), or <member>=<level>, separated by spaces
        required: false
        default: auto
        type: string
      train:
        description: a recorded train's id (train-...) to publish instead of cutting one; the gate and cut are skipped, and the publish resumes from its tag
        required: false
        default: ""
        type: string
  push:
    tags: ["release-train/npm/*"]
permissions:
  contents: read
concurrency:
  group: chant-release
  cancel-in-progress: false
jobs:
  gate:
    if: github.event_name == 'workflow_dispatch' && inputs.train == ''
    runs-on: ubuntu-latest
    permissions:
      contents: read
    defaults:
      run:
        working-directory: release
    outputs:
      commit: ${{ steps.green.outputs.commit }}
      planned: ${{ steps.green.outputs.planned }}
      label-cli-arm: ${{ steps.green.outputs.label-cli-arm }}
      label-web-mac: ${{ steps.green.outputs.label-web-mac }}
    env:
      CHANT_RELEASE_LEVELS: ${{ inputs.levels }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - id: green
        run: |
          commit="$(npx chant ci last-green --from "$GITHUB_SHA" --json | node -e 'const f=process.argv[1];const t=f?require("fs").readFileSync(f,"utf8"):require("fs").readFileSync(0,"utf8");const d=JSON.parse(t);process.stdout.write(String(d.commit?.sha??""))')"
          if [ -z "$commit" ]; then echo "no green commit at or below $GITHUB_SHA, so no release is cut" >&2; exit 1; fi
          if ! git diff --quiet "$commit" "$GITHUB_SHA" -- ":(top).github/workflows"; then
            changed="$(git log -1 --format=%H "$commit..$GITHUB_SHA" -- ":(top).github/workflows")"
            echo "the newest green commit, $commit, has other workflow files than $GITHUB_SHA, and GitHub refuses this job's token a tag on it, so no release is cut. Dispatch again once ${changed:-$GITHUB_SHA}, which changed .github/workflows, or a commit after it is green." >&2
            exit 1
          fi
          echo "commit=$commit" >> "$GITHUB_OUTPUT"
          npx chant workspace train cut npm --at "$commit" --levels "${CHANT_RELEASE_LEVELS:-auto}" --plan-only --json > "$RUNNER_TEMP/chant-train-plan.json"
          echo "planned=$(node -e 'const f=process.argv[1];const t=f?require("fs").readFileSync(f,"utf8"):require("fs").readFileSync(0,"utf8");const d=JSON.parse(t);process.stdout.write(String(d.planned??""))' "$RUNNER_TEMP/chant-train-plan.json")" >> "$GITHUB_OUTPUT"
          echo "label-cli-arm=$(node -e 'const f=process.argv[1];const t=f?require("fs").readFileSync(f,"utf8"):require("fs").readFileSync(0,"utf8");const d=JSON.parse(t);process.stdout.write(String(d.members.find((m)=>m.member==="cli")?.label??""))' "$RUNNER_TEMP/chant-train-plan.json")" >> "$GITHUB_OUTPUT"
          echo "label-web-mac=$(node -e 'const f=process.argv[1];const t=f?require("fs").readFileSync(f,"utf8"):require("fs").readFileSync(0,"utf8");const d=JSON.parse(t);process.stdout.write(String(d.members.find((m)=>m.member==="web")?.label??""))' "$RUNNER_TEMP/chant-train-plan.json")" >> "$GITHUB_OUTPUT"
  build-cli-arm:
    needs: gate
    if: needs.gate.outputs.label-cli-arm != ''
    runs-on: "ubuntu-24.04-arm"
    permissions:
      contents: read
    defaults:
      run:
        shell: bash
        working-directory: release/packages/cli
    env:
      CHANT_RELEASE_LABEL: ${{ needs.gate.outputs.label-cli-arm }}
      GOARCH: "arm64"
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          ref: ${{ needs.gate.outputs.commit }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: "release/packages/cli/go.mod"
          cache: false
      - run: npm ci
        working-directory: release
      - run: "make"
      - run: "tar -cf chant-release-build-cli-arm.tar -- dist/cli"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: chant-release-build-cli-arm
          path: release/packages/cli/chant-release-build-cli-arm.tar
          if-no-files-found: error
          retention-days: 1
  build-web-mac:
    needs: gate
    if: needs.gate.outputs.label-web-mac != ''
    runs-on: ["macos-14"]
    permissions:
      contents: read
    defaults:
      run:
        shell: bash
        working-directory: release/packages/web
    env:
      CHANT_RELEASE_LABEL: ${{ needs.gate.outputs.label-web-mac }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          ref: ${{ needs.gate.outputs.commit }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: make deps
      - run: "make mac"
      - run: "tar -cf chant-release-build-web-mac.tar -- dist/mac"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: chant-release-build-web-mac
          path: release/packages/web/chant-release-build-web-mac.tar
          if-no-files-found: error
          retention-days: 1
  cut:
    needs: [gate, build-cli-arm, build-web-mac]
    if: ${{ !cancelled() && needs.gate.result == 'success' && !contains(needs.*.result, 'failure') }}
    runs-on: ubuntu-latest
    permissions:
      contents: write
    defaults:
      run:
        working-directory: release
    outputs:
      train: ${{ steps.cut.outputs.train }}
    env:
      CHANT_RELEASE_COMMIT: ${{ needs.gate.outputs.commit }}
      CHANT_RELEASE_LEVELS: ${{ inputs.levels }}
      CHANT_TRAIN_PLANNED: ${{ needs.gate.outputs.planned }}
      CHANT_RELEASE_GIT_TOKEN: ${{ github.token }}
      GIT_CONFIG_COUNT: "1"
      GIT_CONFIG_KEY_0: credential.${{ github.server_url }}.helper
      GIT_CONFIG_VALUE_0: "!f() { test \"$1\" = get && echo username=x-access-token && echo \"password=$CHANT_RELEASE_GIT_TOKEN\"; }; f"
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          ref: ${{ needs.gate.outputs.commit }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - run: rc=0; git ls-remote --exit-code --heads origin chant/lifecycle >/dev/null || rc=$?; if [ "$rc" = 0 ]; then git fetch origin chant/lifecycle:chant/lifecycle; elif [ "$rc" != 2 ]; then exit "$rc"; fi
      - if: needs.build-cli-arm.result == 'success'
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: chant-release-build-cli-arm
          path: ${{ runner.temp }}/chant-release-builds
      - if: needs.build-cli-arm.result == 'success'
        run: tar -xkf "$RUNNER_TEMP/chant-release-builds/chant-release-build-cli-arm.tar" -C packages/cli
      - if: needs.build-web-mac.result == 'success'
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: chant-release-build-web-mac
          path: ${{ runner.temp }}/chant-release-builds
      - if: needs.build-web-mac.result == 'success'
        run: tar -xkf "$RUNNER_TEMP/chant-release-builds/chant-release-build-web-mac.tar" -C packages/web
      - id: cut
        run: |
          git config user.name "chant release"
          git config user.email "chant-release@localhost"
          npx chant workspace train cut npm --at "$CHANT_RELEASE_COMMIT" --levels "${CHANT_RELEASE_LEVELS:-auto}" --planned "$CHANT_TRAIN_PLANNED" --doctor --yes --json > "$RUNNER_TEMP/chant-train.json"
          train="$(node -e 'const t=require("fs").readFileSync(process.argv[1],"utf8");let d;try{d=JSON.parse(t)}catch(e){const m=/"id": *"(train-[^"]+)"/.exec(t);console.error("the train cut printed more than its JSON document, so the train id can not be read ("+e.message+")."+(m?" The cut recorded "+m[1]+": dispatch this workflow with train="+m[1]+" to publish it.":" If it recorded a train, dispatch this workflow with train=<id> to publish it."));process.exit(1)}const id=d.train?.id??"";if(!id&&d.released==null&&(d.members??[]).length>0){console.error("the train cut "+d.members.length+" member(s), and its JSON names no train id to publish");process.exit(1)}process.stdout.write(id)' "$RUNNER_TEMP/chant-train.json")" || exit 1
          echo "train=$train" >> "$GITHUB_OUTPUT"
      - if: steps.cut.outputs.train != ''
        run: npx chant workspace train artifacts npm "${{ steps.cut.outputs.train }}" -o "$RUNNER_TEMP/chant-release-artifacts"
      - if: steps.cut.outputs.train != ''
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: chant-release-artifacts
          path: ${{ runner.temp }}/chant-release-artifacts
          if-no-files-found: error
          retention-days: 1
  publish:
    needs: [gate, cut, build-cli-arm, build-web-mac]
    if: ${{ always() && (github.event_name == 'push' || (github.event_name == 'workflow_dispatch' && inputs.train != '') || (needs.cut.result == 'success' && needs.cut.outputs.train != '')) }}
    runs-on: ubuntu-latest
    permissions:
      contents: write
      id-token: write
    defaults:
      run:
        working-directory: release
    env:
      CHANT_RELEASE_TRAIN: ${{ inputs.train || needs.cut.outputs.train }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          ref: ${{ needs.gate.outputs.commit || (inputs.train != '' && format('refs/tags/release-train/npm/{0}', inputs.train)) || github.sha }}
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - run: git fetch origin chant/lifecycle:chant/lifecycle
      - run: echo "CHANT_RELEASE_TRAIN=${CHANT_RELEASE_TRAIN:-${GITHUB_REF_NAME#release-train/npm/}}" >> "$GITHUB_ENV"
      - if: needs.build-cli-arm.result == 'success'
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: chant-release-build-cli-arm
          path: ${{ runner.temp }}/chant-release-builds
      - if: needs.build-cli-arm.result == 'success'
        run: tar -xf "$RUNNER_TEMP/chant-release-builds/chant-release-build-cli-arm.tar" -C packages/cli
      - if: needs.build-web-mac.result == 'success'
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: chant-release-build-web-mac
          path: ${{ runner.temp }}/chant-release-builds
      - if: needs.build-web-mac.result == 'success'
        run: tar -xf "$RUNNER_TEMP/chant-release-builds/chant-release-build-web-mac.tar" -C packages/web
      - run: npx chant workspace train prepare npm "$CHANT_RELEASE_TRAIN"
      - run: npm run build
      - if: needs.cut.outputs.train != ''
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: chant-release-artifacts
          path: ${{ runner.temp }}/chant-release-artifacts
      - run: npx chant workspace train artifacts npm "$CHANT_RELEASE_TRAIN" --from "$RUNNER_TEMP/chant-release-artifacts"
      - run: git config user.name "chant release"
      - run: git config user.email "chant-release@localhost"
      - run: npx chant workspace train publish npm "$CHANT_RELEASE_TRAIN" --yes

# ==== member builds named twice ====
throws: release.workflow.builds: arm is named twice (a train runs every member's builds in one workflow, so each job name is used once across the members)
