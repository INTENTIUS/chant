# ==== after ====
name: chant release publish
on:
  push:
    tags: ["v*", "!v[0-9]+"]
permissions:
  contents: read
jobs:
  publish:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      id-token: write
    outputs:
      label: ${{ steps.label.outputs.label }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - run: git fetch origin chant/lifecycle:chant/lifecycle
      - id: label
        run: |
          label="$(npx chant release tag "$GITHUB_REF_NAME" --json | node -e 'const f=process.argv[1];const t=f?require("fs").readFileSync(f,"utf8"):require("fs").readFileSync(0,"utf8");const d=JSON.parse(t);process.stdout.write(String(d.label??""))')" || label=""
          if [ -z "$label" ]; then echo "$GITHUB_REF_NAME names no release of this member, so nothing is published" >&2; exit 1; fi
          echo "CHANT_RELEASE_LABEL=$label" >> "$GITHUB_ENV"
          echo "label=$label" >> "$GITHUB_OUTPUT"
      - run: npm run build
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - run: npx chant release publish "$CHANT_RELEASE_LABEL" --yes
  after-release:
    needs: publish
    runs-on: ubuntu-latest
    permissions:
      contents: read
    env:
      CHANT_RELEASE_LABEL: ${{ needs.publish.outputs.label }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - run: npm run announce
      - run: echo done

# ==== env and setup ====
name: chant release publish
on:
  push:
    tags: ["v*", "!v[0-9]+"]
permissions:
  contents: read
jobs:
  publish:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      id-token: write
    env:
      OCI_USERNAME: "bot"
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - run: "echo setup"
      - name: "named"
        run: "echo named"
        env:
          A: "1"
      - run: git fetch origin chant/lifecycle:chant/lifecycle
      - id: label
        run: |
          label="$(npx chant release tag "$GITHUB_REF_NAME" --json | node -e 'const f=process.argv[1];const t=f?require("fs").readFileSync(f,"utf8"):require("fs").readFileSync(0,"utf8");const d=JSON.parse(t);process.stdout.write(String(d.label??""))')" || label=""
          if [ -z "$label" ]; then echo "$GITHUB_REF_NAME names no release of this member, so nothing is published" >&2; exit 1; fi
          echo "CHANT_RELEASE_LABEL=$label" >> "$GITHUB_ENV"
          echo "label=$label" >> "$GITHUB_OUTPUT"
      - run: npm run build
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - run: npx chant release publish "$CHANT_RELEASE_LABEL" --yes

