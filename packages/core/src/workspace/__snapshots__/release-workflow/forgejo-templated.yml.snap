# ==== doctor on ====
name: chant release publish
on:
  push:
    tags: ["v*", "!v[0-9]+"]
permissions:
  contents: read
jobs:
  publish:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      id-token: write
