        type: string
permissions:
  contents: read
concurrency:
  group: chant-release
  cancel-in-progress: false
env:
  CHANT_RELEASE_LABEL: ${{ inputs.label }}
jobs:
  gate:
    runs-on: ubuntu-latest
    permissions:
