        with:
          go-version: "1.23"
          cache: false
      - run: npm ci
      - run: npm run build
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - run: git fetch origin chant/lifecycle:chant/lifecycle
      - run: npx chant release publish "${GITHUB_REF_NAME#release/}" --yes

# ==== toolchains off ====
name: chant release publish
on:
  push:
    tags: ["release/**"]
permissions:
  contents: read
jobs:
  publish:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      id-token: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      - run: npm ci
      - run: npm run build
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - run: git fetch origin chant/lifecycle:chant/lifecycle
      - run: npx chant release publish "${GITHUB_REF_NAME#release/}" --yes

# ==== builds ====
name: chant release publish
on:
  push:
    tags: ["release/**"]
permissions:
  contents: read
jobs:
  publish:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      id-token: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - run: npm run build
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - run: git fetch origin chant/lifecycle:chant/lifecycle
      - run: npx chant release publish "${GITHUB_REF_NAME#release/}" --yes

# ==== everything ====
name: chant release publish
on:
  push:
    tags: ["release/**"]
permissions:
  contents: read
jobs:
  publish:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      id-token: write
    defaults:
      run:
        working-directory: packages/app
    env:
      GITHUB_TOKEN: ${{ github.token }}
      EXTRA: "1"
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - uses: docker/setup-qemu-action@99012661954931238ded8c8b007157a8430204e1 # v4.4.0
        with:
          platforms: "arm64"
      - run: "echo setup"
      - run: "have=\"$(npm --version)\"; if [ \"$(printf '%s\\n' \"11.5.1\" \"$have\" | sort -V | head -n1)\" != \"11.5.1\" ]; then npm install -g npm@11.19.0; fi; npm --version"
      - name: "Install cosign v3.1.4"
        run: "curl -fsSL -o \"$RUNNER_TEMP/cosign\" https://github.com/sigstore/cosign/releases/download/v3.1.4/cosign-linux-amd64 && echo \"424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa  $RUNNER_TEMP/cosign\" | sha256sum -c - && chmod +x \"$RUNNER_TEMP/cosign\" && echo \"CHANT_COSIGN=$RUNNER_TEMP/cosign\" >> \"$GITHUB_ENV\""
      - run: npx chant release doctor
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: packages/app/go.mod
      - name: goreleaser v2.19.0
        run: "mkdir -p \"$RUNNER_TEMP/goreleaser\" && curl -fsSL -o \"$RUNNER_TEMP/goreleaser/goreleaser.tar.gz\" https://github.com/goreleaser/goreleaser/releases/download/v2.19.0/goreleaser_Linux_x86_64.tar.gz && echo \"ebc3194ad1d1b1787614405285a0039665cd4c5bd3305215a1b201600f90630b  $RUNNER_TEMP/goreleaser/goreleaser.tar.gz\" | sha256sum -c - && tar -xzf \"$RUNNER_TEMP/goreleaser/goreleaser.tar.gz\" -C \"$RUNNER_TEMP/goreleaser\" goreleaser && echo \"CHANT_GORELEASER=$RUNNER_TEMP/goreleaser/goreleaser\" >> \"$GITHUB_ENV\""
      - run: npx chant release stamp "${GITHUB_REF_NAME#release/}"
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - run: git fetch origin chant/lifecycle:chant/lifecycle
      - run: npx chant release images "${GITHUB_REF_NAME#release/}" -o "$RUNNER_TEMP/chant-release-digests.json"
      - run: echo "CHANT_RELEASE_DIGESTS=$RUNNER_TEMP/chant-release-digests.json" >> "$GITHUB_ENV"
      - run: npx chant release artifacts "${GITHUB_REF_NAME#release/}"
      - run: npm run build
      - run: npx chant release verify "${GITHUB_REF_NAME#release/}"
      - run: npx chant release publish "${GITHUB_REF_NAME#release/}" --require-provenance --yes
  after-release:
    needs: publish
    runs-on: ubuntu-latest
    permissions:
      contents: read
    defaults:
      run:
        working-directory: packages/app
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: echo "CHANT_RELEASE_LABEL=${GITHUB_REF_NAME#release/}" >> "$GITHUB_ENV"
      - run: npm ci
      - run: echo after
