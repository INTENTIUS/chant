# ==== scan ====
name: chant release publish
on:
  push:
    tags: ["release/**"]
permissions:
  contents: read
jobs:
  publish:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      id-token: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - name: "Install grype v0.121.1"
        run: "case \"$(uname -m)\" in x86_64|amd64) mkdir -p \"$RUNNER_TEMP/grype\" && curl -fsSL -o \"$RUNNER_TEMP/grype/grype.tar.gz\" https://github.com/anchore/grype/releases/download/v0.121.1/grype_0.121.1_linux_amd64.tar.gz && echo \"bc3ea3f9e6fd56ac781c08c6c5e614271b79f438200757f6932085c19b0a4657  $RUNNER_TEMP/grype/grype.tar.gz\" | sha256sum -c - && tar -xzf \"$RUNNER_TEMP/grype/grype.tar.gz\" -C \"$RUNNER_TEMP/grype\" grype;; aarch64|arm64) mkdir -p \"$RUNNER_TEMP/grype\" && curl -fsSL -o \"$RUNNER_TEMP/grype/grype.tar.gz\" https://github.com/anchore/grype/releases/download/v0.121.1/grype_0.121.1_linux_arm64.tar.gz && echo \"33670612aad351c48cf3c37f4a85d8b043d1b64b21e6034e675bb00b956d78c1  $RUNNER_TEMP/grype/grype.tar.gz\" | sha256sum -c - && tar -xzf \"$RUNNER_TEMP/grype/grype.tar.gz\" -C \"$RUNNER_TEMP/grype\" grype;; *) echo \"no pinned grype v0.121.1 build for $(uname -m)\" >&2; exit 1;; esac && echo \"CHANT_GRYPE=$RUNNER_TEMP/grype/grype\" >> \"$GITHUB_ENV\""
      - name: "Install syft v1.56.0"
        run: "case \"$(uname -m)\" in x86_64|amd64) mkdir -p \"$RUNNER_TEMP/syft\" && curl -fsSL -o \"$RUNNER_TEMP/syft/syft.tar.gz\" https://github.com/anchore/syft/releases/download/v1.56.0/syft_1.56.0_linux_amd64.tar.gz && echo \"1c2493cfcf52d3367d6cb25780d9190c111c2219c34c820574c43e8bae15c528  $RUNNER_TEMP/syft/syft.tar.gz\" | sha256sum -c - && tar -xzf \"$RUNNER_TEMP/syft/syft.tar.gz\" -C \"$RUNNER_TEMP/syft\" syft;; aarch64|arm64) mkdir -p \"$RUNNER_TEMP/syft\" && curl -fsSL -o \"$RUNNER_TEMP/syft/syft.tar.gz\" https://github.com/anchore/syft/releases/download/v1.56.0/syft_1.56.0_linux_arm64.tar.gz && echo \"ace61b9397ae28189c674ae332d67a8074dafd71e87724dfb8b22412d8253bb5  $RUNNER_TEMP/syft/syft.tar.gz\" | sha256sum -c - && tar -xzf \"$RUNNER_TEMP/syft/syft.tar.gz\" -C \"$RUNNER_TEMP/syft\" syft;; *) echo \"no pinned syft v1.56.0 build for $(uname -m)\" >&2; exit 1;; esac && echo \"CHANT_SYFT=$RUNNER_TEMP/syft/syft\" >> \"$GITHUB_ENV\""
      - run: npm run build
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - run: git fetch origin chant/lifecycle:chant/lifecycle
      - run: npx chant release publish "${GITHUB_REF_NAME#release/}" --yes

# ==== pull login ====
name: chant release publish
on:
  push:
    tags: ["release/**"]
permissions:
  contents: read
jobs:
  publish:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      id-token: write
    env:
      CGR_USERNAME: "${{ secrets.CGR_USERNAME }}"
      CGR_PASSWORD: "${{ secrets.CGR_PASSWORD }}"
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org
      - run: npm ci
      - name: "Log in to cgr.dev"
        run: "printf '%s' \"$CGR_PASSWORD\" | docker login cgr.dev --username \"$CGR_USERNAME\" --password-stdin"
      - run: git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'
      - run: git fetch origin chant/lifecycle:chant/lifecycle
      - run: npx chant release images "${GITHUB_REF_NAME#release/}" -o "$RUNNER_TEMP/chant-release-digests.json"
      - run: echo "CHANT_RELEASE_DIGESTS=$RUNNER_TEMP/chant-release-digests.json" >> "$GITHUB_ENV"
      - run: npm run build
      - run: npx chant release publish "${GITHUB_REF_NAME#release/}" --yes

