# ==== minimal ====
chant-release-publish:
  rules:
    - if: $CI_COMMIT_TAG =~ /^release-train\/npm\//
  variables:
    GIT_DEPTH: "0"
  resource_group: chant-release
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "export CHANT_RELEASE_TRAIN=\"${CHANT_RELEASE_TRAIN:-${CHANT_TRAIN_CUT:-${CI_COMMIT_TAG#release-train/npm/}}}\""
    - "if [ -z \"$CHANT_RELEASE_TRAIN\" ]; then echo \"no release train was cut or named, so there is nothing to publish\"; exit 0; fi"
    - "git fetch origin \"refs/tags/release-train/npm/$CHANT_RELEASE_TRAIN\""
    - "git checkout --detach FETCH_HEAD"
    - "npm ci"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "npx chant workspace train prepare npm \"$CHANT_RELEASE_TRAIN\""
    - "npm run build"
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant workspace train publish npm \"$CHANT_RELEASE_TRAIN\" --yes"

# ==== no install, no build ====
chant-release-publish:
  rules:
    - if: $CI_COMMIT_TAG =~ /^release-train\/npm\//
  variables:
    GIT_DEPTH: "0"
  resource_group: chant-release
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "export CHANT_RELEASE_TRAIN=\"${CHANT_RELEASE_TRAIN:-${CHANT_TRAIN_CUT:-${CI_COMMIT_TAG#release-train/npm/}}}\""
    - "if [ -z \"$CHANT_RELEASE_TRAIN\" ]; then echo \"no release train was cut or named, so there is nothing to publish\"; exit 0; fi"
    - "git fetch origin \"refs/tags/release-train/npm/$CHANT_RELEASE_TRAIN\""
    - "git checkout --detach FETCH_HEAD"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "npx chant workspace train prepare npm \"$CHANT_RELEASE_TRAIN\""
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant workspace train publish npm \"$CHANT_RELEASE_TRAIN\" --yes"

# ==== member root ====
chant-release-publish:
  rules:
    - if: $CI_COMMIT_TAG =~ /^release-train\/npm\//
  variables:
    GIT_DEPTH: "0"
  resource_group: chant-release
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "export CHANT_RELEASE_TRAIN=\"${CHANT_RELEASE_TRAIN:-${CHANT_TRAIN_CUT:-${CI_COMMIT_TAG#release-train/npm/}}}\""
    - "if [ -z \"$CHANT_RELEASE_TRAIN\" ]; then echo \"no release train was cut or named, so there is nothing to publish\"; exit 0; fi"
    - "git fetch origin \"refs/tags/release-train/npm/$CHANT_RELEASE_TRAIN\""
    - "git checkout --detach FETCH_HEAD"
    - "cd release"
    - "npm ci"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "npx chant workspace train prepare npm \"$CHANT_RELEASE_TRAIN\""
    - "npm run build"
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant workspace train publish npm \"$CHANT_RELEASE_TRAIN\" --yes"

# ==== supply-chain ====
chant-release-publish:
  rules:
    - if: $CI_COMMIT_TAG =~ /^release-train\/npm\//
  variables:
    GIT_DEPTH: "0"
  resource_group: chant-release
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "export CHANT_RELEASE_TRAIN=\"${CHANT_RELEASE_TRAIN:-${CHANT_TRAIN_CUT:-${CI_COMMIT_TAG#release-train/npm/}}}\""
    - "if [ -z \"$CHANT_RELEASE_TRAIN\" ]; then echo \"no release train was cut or named, so there is nothing to publish\"; exit 0; fi"
    - "git fetch origin \"refs/tags/release-train/npm/$CHANT_RELEASE_TRAIN\""
    - "git checkout --detach FETCH_HEAD"
    - "npm ci"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "npx chant workspace train prepare npm \"$CHANT_RELEASE_TRAIN\""
    - "npm run build"
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant workspace train publish npm \"$CHANT_RELEASE_TRAIN\" --require-provenance --yes"

# ==== signing ====
chant-release-publish:
  rules:
    - if: $CI_COMMIT_TAG =~ /^release-train\/npm\//
  variables:
    GIT_DEPTH: "0"
  resource_group: chant-release
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "export CHANT_RELEASE_TRAIN=\"${CHANT_RELEASE_TRAIN:-${CHANT_TRAIN_CUT:-${CI_COMMIT_TAG#release-train/npm/}}}\""
    - "if [ -z \"$CHANT_RELEASE_TRAIN\" ]; then echo \"no release train was cut or named, so there is nothing to publish\"; exit 0; fi"
    - "git fetch origin \"refs/tags/release-train/npm/$CHANT_RELEASE_TRAIN\""
    - "git checkout --detach FETCH_HEAD"
    - "npm ci"
    - "case \"$(uname -m)\" in x86_64|amd64) curl -fsSL -o \"/tmp/cosign\" https://github.com/sigstore/cosign/releases/download/v3.1.4/cosign-linux-amd64 && echo \"424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa  /tmp/cosign\" | sha256sum -c - && chmod +x \"/tmp/cosign\";; aarch64|arm64) curl -fsSL -o \"/tmp/cosign\" https://github.com/sigstore/cosign/releases/download/v3.1.4/cosign-linux-arm64 && echo \"ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2  /tmp/cosign\" | sha256sum -c - && chmod +x \"/tmp/cosign\";; *) echo \"no pinned cosign v3.1.4 build for $(uname -m)\" >&2; exit 1;; esac && export CHANT_COSIGN=/tmp/cosign"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "npx chant workspace train prepare npm \"$CHANT_RELEASE_TRAIN\""
    - "npm run build"
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant workspace train publish npm \"$CHANT_RELEASE_TRAIN\" --yes"

