# ==== scan ====
chant-release-publish:
  rules:
    - if: $CI_COMMIT_TAG =~ /^release-train\/npm\//
  variables:
    GIT_DEPTH: "0"
  resource_group: chant-release
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "export CHANT_RELEASE_TRAIN=\"${CHANT_RELEASE_TRAIN:-${CHANT_TRAIN_CUT:-${CI_COMMIT_TAG#release-train/npm/}}}\""
    - "if [ -z \"$CHANT_RELEASE_TRAIN\" ]; then echo \"no release train was cut or named, so there is nothing to publish\"; exit 0; fi"
    - "git fetch origin \"refs/tags/release-train/npm/$CHANT_RELEASE_TRAIN\""
    - "git checkout --detach FETCH_HEAD"
    - "npm ci"
    - "case \"$(uname -m)\" in x86_64|amd64) mkdir -p \"/tmp/grype\" && curl -fsSL -o \"/tmp/grype/grype.tar.gz\" https://github.com/anchore/grype/releases/download/v0.121.1/grype_0.121.1_linux_amd64.tar.gz && echo \"bc3ea3f9e6fd56ac781c08c6c5e614271b79f438200757f6932085c19b0a4657  /tmp/grype/grype.tar.gz\" | sha256sum -c - && tar -xzf \"/tmp/grype/grype.tar.gz\" -C \"/tmp/grype\" grype;; aarch64|arm64) mkdir -p \"/tmp/grype\" && curl -fsSL -o \"/tmp/grype/grype.tar.gz\" https://github.com/anchore/grype/releases/download/v0.121.1/grype_0.121.1_linux_arm64.tar.gz && echo \"33670612aad351c48cf3c37f4a85d8b043d1b64b21e6034e675bb00b956d78c1  /tmp/grype/grype.tar.gz\" | sha256sum -c - && tar -xzf \"/tmp/grype/grype.tar.gz\" -C \"/tmp/grype\" grype;; *) echo \"no pinned grype v0.121.1 build for $(uname -m)\" >&2; exit 1;; esac && export CHANT_GRYPE=/tmp/grype/grype"
    - "case \"$(uname -m)\" in x86_64|amd64) mkdir -p \"/tmp/syft\" && curl -fsSL -o \"/tmp/syft/syft.tar.gz\" https://github.com/anchore/syft/releases/download/v1.56.0/syft_1.56.0_linux_amd64.tar.gz && echo \"1c2493cfcf52d3367d6cb25780d9190c111c2219c34c820574c43e8bae15c528  /tmp/syft/syft.tar.gz\" | sha256sum -c - && tar -xzf \"/tmp/syft/syft.tar.gz\" -C \"/tmp/syft\" syft;; aarch64|arm64) mkdir -p \"/tmp/syft\" && curl -fsSL -o \"/tmp/syft/syft.tar.gz\" https://github.com/anchore/syft/releases/download/v1.56.0/syft_1.56.0_linux_arm64.tar.gz && echo \"ace61b9397ae28189c674ae332d67a8074dafd71e87724dfb8b22412d8253bb5  /tmp/syft/syft.tar.gz\" | sha256sum -c - && tar -xzf \"/tmp/syft/syft.tar.gz\" -C \"/tmp/syft\" syft;; *) echo \"no pinned syft v1.56.0 build for $(uname -m)\" >&2; exit 1;; esac && export CHANT_SYFT=/tmp/syft/syft"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "npx chant workspace train prepare npm \"$CHANT_RELEASE_TRAIN\""
    - "npm run build"
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant workspace train publish npm \"$CHANT_RELEASE_TRAIN\" --yes"

# ==== pull login ====
chant-release-publish:
  rules:
    - if: $CI_COMMIT_TAG =~ /^release-train\/npm\//
  variables:
    GIT_DEPTH: "0"
  resource_group: chant-release
  id_tokens:
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  script:
    - "export CHANT_RELEASE_TRAIN=\"${CHANT_RELEASE_TRAIN:-${CHANT_TRAIN_CUT:-${CI_COMMIT_TAG#release-train/npm/}}}\""
    - "if [ -z \"$CHANT_RELEASE_TRAIN\" ]; then echo \"no release train was cut or named, so there is nothing to publish\"; exit 0; fi"
    - "git fetch origin \"refs/tags/release-train/npm/$CHANT_RELEASE_TRAIN\""
    - "git checkout --detach FETCH_HEAD"
    - "npm ci"
    - "printf '%s' \"$CGR_PASSWORD\" | docker login cgr.dev --username \"$CGR_USERNAME\" --password-stdin"
    - "git fetch origin 'refs/tags/ci/*:refs/tags/ci/*'"
    - "git fetch origin chant/lifecycle:chant/lifecycle"
    - "npx chant workspace train prepare npm \"$CHANT_RELEASE_TRAIN\""
    - "npm run build"
    - "npx chant workspace train artifacts npm \"$CHANT_RELEASE_TRAIN\""
    - "git config user.name \"chant release\""
    - "git config user.email \"chant-release@localhost\""
    - "npx chant workspace train publish npm \"$CHANT_RELEASE_TRAIN\" --yes"

