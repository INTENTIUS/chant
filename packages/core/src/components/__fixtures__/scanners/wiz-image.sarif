{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Wiz CLI",
          "rules": [
            { "id": "CVE-2026-50002", "properties": { "security-severity": "9.8" } },
            { "id": "CVE-2026-50003", "properties": { "security-severity": "3.1" } }
          ]
        }
      },
      "results": [
        { "ruleId": "CVE-2026-50002", "level": "error", "message": { "text": "Vulnerability in package openssl version 3.0.11-1" }, "properties": { "packageName": "debian/openssl", "packageVersion": "3.0.11-1", "fixedVersion": "3.0.15-1" } },
        { "ruleId": "CVE-2026-50003", "level": "note", "message": { "text": "Vulnerability in package zlib 1.2.13" }, "properties": { "packageName": "debian/zlib", "packageVersion": "1.2.13" } }
      ]
    }
  ]
}
