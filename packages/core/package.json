{
  "name": "@intentius/chant",
  "version": "0.124.34",
  "description": "Declarative infrastructure-as-code toolkit — TypeScript on Node.js",
  "license": "Apache-2.0",
  "homepage": "https://intentius.io/chant",
  "repository": {
    "type": "git",
    "url": "https://github.com/INTENTIUS/chant.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/INTENTIUS/chant/issues"
  },
  "keywords": [
    "infrastructure-as-code",
    "iac",
    "typescript",
    "declarative",
    "cloudformation",
    "aws",
    "devops"
  ],
  "type": "module",
  "files": [
    "dist/",
    "!dist/**/*.map",
    "bin/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "chant": "./bin/chant",
    "chant-wave": "./dist/wave-runtime.mjs"
  },
  "exports": {
    ".": {
      "@intentius/chant-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./yaml": {
      "@intentius/chant-source": "./src/yaml.ts",
      "types": "./dist/yaml.d.ts",
      "import": "./dist/yaml.js",
      "default": "./dist/yaml.js"
    },
    "./cli": {
      "@intentius/chant-source": "./src/cli/index.ts",
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    },
    "./workspace/*.schema.json": {
      "@intentius/chant-source": "./src/workspace/*.schema.json",
      "default": "./dist/workspace/*.schema.json"
    },
    "./capabilities/templates.json": {
      "@intentius/chant-source": "./src/capabilities/templates.json",
      "default": "./dist/capabilities/templates.json"
    },
    "./notify.schema.json": {
      "@intentius/chant-source": "./src/notify.schema.json",
      "default": "./dist/notify.schema.json"
    },
    "./health.schema.json": {
      "@intentius/chant-source": "./src/health.schema.json",
      "default": "./dist/health.schema.json"
    },
    "./gate-statement.schema.json": {
      "@intentius/chant-source": "./src/gate-statement.schema.json",
      "default": "./dist/gate-statement.schema.json"
    },
    "./workspace/factory-rules": {
      "@intentius/chant-source": "./src/workspace/factory-rules.ts",
      "types": "./dist/workspace/factory-rules.d.ts",
      "import": "./dist/workspace/factory-rules.js",
      "default": "./dist/workspace/factory-rules.js"
    },
    "./workspace/conformance": {
      "@intentius/chant-source": "./src/workspace/conformance/index.ts",
      "types": "./dist/workspace/conformance/index.d.ts",
      "import": "./dist/workspace/conformance/index.js",
      "default": "./dist/workspace/conformance/index.js"
    },
    "./workspace/conformance/vitest": {
      "@intentius/chant-source": "./src/workspace/conformance/vitest.ts",
      "types": "./dist/workspace/conformance/vitest.d.ts",
      "import": "./dist/workspace/conformance/vitest.js",
      "default": "./dist/workspace/conformance/vitest.js"
    },
    "./cli/*": {
      "@intentius/chant-source": "./src/cli/*.ts",
      "types": "./dist/cli/*.d.ts",
      "import": "./dist/cli/*.js",
      "default": "./dist/cli/*.js"
    },
    "./op": {
      "@intentius/chant-source": "./src/op/index.ts",
      "types": "./dist/op/index.d.ts",
      "import": "./dist/op/index.js",
      "default": "./dist/op/index.js"
    },
    "./op/activities": {
      "@intentius/chant-source": "./src/op/activities/index.ts",
      "types": "./dist/op/activities/index.d.ts",
      "import": "./dist/op/activities/index.js",
      "default": "./dist/op/activities/index.js"
    },
    "./template-request": {
      "@intentius/chant-source": "./src/template-request/index.ts",
      "types": "./dist/template-request/index.d.ts",
      "import": "./dist/template-request/index.js",
      "default": "./dist/template-request/index.js"
    },
    "./template-request/*.schema.json": {
      "@intentius/chant-source": "./src/template-request/*.schema.json",
      "default": "./dist/template-request/*.schema.json"
    },
    "./components": {
      "@intentius/chant-source": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./testing": {
      "@intentius/chant-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./agents": {
      "@intentius/chant-source": "./src/agents/index.ts",
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js",
      "default": "./dist/agents/index.js"
    },
    "./notify-verify": {
      "@intentius/chant-source": "./src/notify-verify.ts",
      "types": "./dist/notify-verify.d.ts",
      "import": "./dist/notify-verify.js",
      "default": "./dist/notify-verify.js"
    },
    "./runner-start": {
      "@intentius/chant-source": "./src/runner-start.ts",
      "types": "./dist/runner-start.d.ts",
      "import": "./dist/runner-start.js",
      "default": "./dist/runner-start.js"
    },
    "./notify": {
      "@intentius/chant-source": "./src/notify.ts",
      "types": "./dist/notify.d.ts",
      "import": "./dist/notify.js",
      "default": "./dist/notify.js"
    },
    "./wave-runtime.mjs": "./dist/wave-runtime.mjs",
    "./bucket-check/fixtures/*.json": {
      "@intentius/chant-source": "./src/bucket-check/fixtures/*.json",
      "default": "./dist/bucket-check/fixtures/*.json"
    },
    "./object-store": {
      "@intentius/chant-source": "./src/object-store/index.ts",
      "types": "./dist/object-store/index.d.ts",
      "import": "./dist/object-store/index.js",
      "default": "./dist/object-store/index.js"
    },
    "./*": {
      "@intentius/chant-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "../../scripts/tsc7.sh -p tsconfig.build.json --sourceMap false && tsc-alias -p tsconfig.build.json && node scripts/copy-assets.mjs && node scripts/build-wave-runtime.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "ajv": "^8.20.0",
    "fflate": "^0.8.2",
    "js-yaml": "^4.3.1",
    "picomatch": "^4.0.3",
    "typescript": "^5.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cdktn/hcl2json": "^0.24.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.0.0"
  },
  "peerDependencies": {
    "@aws-sdk/credential-providers": "^3.0.0",
    "@azure/identity": "^4.0.0",
    "esbuild": "^0.28.1",
    "google-auth-library": "^9.0.0 || ^10.0.0",
    "tsx": "^4.0.0",
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/credential-providers": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "google-auth-library": {
      "optional": true
    },
    "tsx": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
