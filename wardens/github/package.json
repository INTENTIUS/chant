{
  "name": "@intentius/github-warden",
  "version": "0.3.0",
  "type": "module",
  "description": "Keep your GitHub org and repos in declared state \u2014 reconcile, guardrails, drift correction",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INTENTIUS/chant.git",
    "directory": "wardens/github"
  },
  "homepage": "https://github.com/INTENTIUS/chant/tree/main/wardens/github#readme",
  "bugs": {
    "url": "https://github.com/INTENTIUS/chant/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "github-warden": "bin/github-warden.js"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build": "tsc -p tsconfig.build.json && esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js && chmod +x dist/cli.js",
    "build:action": "esbuild src/action.ts --bundle --platform=node --format=esm --define:process.env.GITHUB_WARDEN_IS_ACTION='\"1\"' --outfile=action/index.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@intentius/warden-core": "*",
    "@intentius/chant": "*",
    "@intentius/chant-lexicon-github": "*",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "libsodium-wrappers": "^0.8.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@intentius/chant": "^0.41.19",
    "@intentius/chant-lexicon-github": "^0.41.19",
    "@intentius/warden-core": "^0.41.19"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  }
}
